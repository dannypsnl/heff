-- | an alias of one file's, over the table's: where two imports of the
-- | file would have one alias
type Override = { file : String, module : String, alias : String }

overrides : List Override
overrides = []

-- | files whose aliases are what they are of, left as they are
kept : List String
kept =
  [ "test/surface/list.hf" -- `import list as L`: lists by another name
  , "test/modules/value-use.hf" -- `P` alone, the module as a value
  , "test/errors/import-again.hf" -- `import map as M` twice, an error
  ]

-- Renaming one text ---------------------------------------------------------

type Rename = { old : String, new : String }

type Edit = { start : Int, end : Int, text : String }

-- | a text renamed: how many aliases and uses were, what is to be said
-- | of it, and why it is left as it is, if it is
type Done =
  { text : String
  , aliases : Int
  , uses : Int
  , said : List String
  , problems : List String
  }

unchanged : String -> List String -> Done
unchanged src said =
  { text = src, aliases = 0, uses = 0, said = said, problems = Nil }

orTable : String -> Maybe Override -> Maybe String
orTable m (Just o) = Just o.alias
orTable m Nothing = List.lookup m aliases

-- | the alias the module `m` has in the file `f`
aliasOf : String -> String -> Maybe String
aliasOf f m =
  orTable
    m
    (List.find
       (\(o : Override) -> strEq o.file f && strEq o.module m)
       overrides)

changed : String -> Maybe String -> Maybe Rename
changed old (Just new) =
  if strEq old new then Nothing else Just { old = old, new = new }
changed old Nothing = Nothing

renameOf : String -> Import.Import -> Maybe Rename
renameOf f imp = maybe Nothing (\a -> changed a (aliasOf f imp.name)) imp.alias

justs : {a : Type} -> List (Maybe a) -> List a
justs xs = List.concatMap (\m -> maybe Nil (\x -> [x]) m) xs

oldIn : List Rename -> String -> Bool
oldIn rs a = List.any (\(r : Rename) -> strEq r.old a) rs

newOf : List Rename -> String -> String
newOf rs a =
  maybe
    a
    (\(r : Rename) -> r.new)
    (List.find (\(r : Rename) -> strEq r.old a) rs)

-- | `X.y`: a capitalised name (a keyword too: `Rune`), a field right
-- | after it
qualified : Lex.Tok -> Lex.Tok -> Bool
qualified t u =
  (strEq t.kind "con" || strEq t.kind "kw")
  && strEq u.kind "field"
  && u.start == t.end

qualifiersGo : List Lex.Tok -> List Lex.Tok -> List Lex.Tok
qualifiersGo (t :: u :: rest) acc =
  qualifiersGo (u :: rest) (if qualified t u then t :: acc else acc)
qualifiersGo _ acc = List.reverse acc

-- | the `X` of each `X.y`
qualifiers : List Lex.Tok -> List Lex.Tok
qualifiers ts = qualifiersGo ts Nil

isName : String -> Lex.Tok -> Bool
isName a t = (strEq t.kind "con" || strEq t.kind "kw") && strEq t.text a

count : {a : Type} -> (a -> Bool) -> List a -> Int
count p xs = List.length (List.keepIf p xs)

nameC : Int -> Bool
nameC c =
  c >= 97 && c <= 122
  || c >= 65 && c <= 90
  || c >= 48 && c <= 57
  || c == 95
  || c == 39

mentionsFrom : String -> String -> Int -> Bool
mentionsFrom pat s i =
  maybe
    False
    (\j ->
       j == 0 || not (nameC (byteAt s (j - 1))) || mentionsFrom pat s (j + 1))
    (indexOf pat s i)

-- | whether `X.` is in the text, not as the end of a longer name
mentions : String -> String -> Bool
mentions a s = mentionsFrom (a ^ ".") s 0

dupsGo : List String -> List String -> List String -> List String
dupsGo [] seen acc = List.reverse acc
dupsGo (x :: rest) seen acc =
  dupsGo
    rest
    (x :: seen)
    (if List.elem x seen && not (List.elem x acc)
     then x :: acc
     else acc)

-- | the names that are in the list more than once, each once
dups : List String -> List String
dups xs = dupsGo xs Nil Nil

applyGo : String -> Int -> List Edit -> List String -> String
applyGo s at [] acc =
  joinWith "" (List.reverse (strSlice s at (strLength s) :: acc))
applyGo s at (e :: rest) acc =
  applyGo s e.end rest (e.text :: strSlice s at e.start :: acc)

-- | the edits made, in the order of the text (none over another)
applyEdits : String -> List Edit -> String
applyEdits s es =
  applyGo
    s
    0
    (List.sortOn (\(a : Edit) -> a.start) es)
    Nil

-- | an import line written anew, with the new alias
importEdit : String -> Import.Import -> Maybe Edit
importEdit f imp =
  maybe
    Nothing
    (\(r : Rename) ->
       Just
         { start = imp.span.start
         , end = imp.span.end
         , text = "import " ^ imp.name ^ " as " ^ r.new
         })
    (renameOf f imp)

useEdit : List Rename -> Lex.Tok -> Edit
useEdit rs t = { start = t.start, end = t.end, text = newOf rs t.text }

bareSaid : Rename -> Int -> List String
bareSaid r 0 = Nil
bareSaid r n =
  [ debug n
  ^ " `"
  ^ r.old
  ^ "` left as it is, not before a `.`: a type, a tag, a field"
  ]

commentSaid : Rename -> Int -> List String
commentSaid r 0 = Nil
commentSaid r n =
  [debug n ^ " comment(s) left as they are that write `" ^ r.old ^ ".`"]

-- (an expectation's line, from past its `--` or `-- |` to its end)
type Line = { start : Int, end : Int }

spacesEnd : String -> Int -> Int
spacesEnd s i = if byteAt s i == 32 then spacesEnd s (i + 1) else i

lineEnd : String -> Int -> Int
lineEnd s i = fromMaybe (strLength s) (indexOf "\n" s i)

-- | the line from `p` (past its spaces) to `e` as an expectation's, if
-- | it is one, as heff.build.driver's `docExpect` and `watchExpect` read
-- | it: a doc test's `-- | v`, a watch's `-- v`, `v` not blank
expectText : Bool -> String -> Int -> Int -> Maybe Line
expectText True s p e =
  if strEq (strSlice s p (p + 4)) "-- |"
     && not (strEq (strSlice s p (p + 8)) "-- | >>>")
     && not (strEq (trim (strSlice s (p + 4) e)) "")
  then Just { start = p + 4, end = e }
  else Nothing
expectText False s p e =
  if strEq (strSlice s p (p + 2)) "--"
     && not (strEq (strSlice s p (p + 6)) "-- >>>")
     && not (strEq (strSlice s p (p + 4)) "-- |")
     && not (strEq (trim (strSlice s (p + 2) e)) "")
  then Just { start = p + 2, end = e }
  else Nothing

expectLinesGo : Bool -> String -> Int -> List Line -> List Line
expectLinesGo doc s i acc =
  if i >= strLength s then List.reverse acc
  else maybe
      (List.reverse acc)
      (\(l : Line) -> (expectLinesGo doc s (l.end + 1) (l :: acc) : List Line))
      (expectText doc s (spacesEnd s i) (lineEnd s i))

-- | the lines of the expectation of a watch or a doc test, under its line
expectLines : String -> Lex.Tok -> List Line
expectLines s t =
  if strEq t.kind "watch" || strEq t.kind "doctest"
  then expectLinesGo (strEq t.kind "doctest") s (lineEnd s t.start + 1) Nil
  else Nil

shifted : Int -> Lex.Tok -> Lex.Tok
shifted d t =
  Lex.mkTok t.kind t.text (t.start + d) (t.end + d) t.line t.col t.first

-- | the qualifiers of an expectation's line, lexed as code
lineQualifiers : String -> Line -> List Lex.Tok
lineQualifiers s l =
  List.map
    (shifted l.start)
    (qualifiers (Lex.lex (strSlice s l.start l.end)).tokens)

inLines : List Line -> Lex.Cmt -> Bool
inLines ls c =
  List.any (\(l : Line) -> c.start <= l.start && l.start <= c.end) ls

-- | what is said of one alias renamed: its uses (`quals`, the qualifiers
-- | of the code and of its expectations), and what is left of its name:
-- | in the code `toks`, and in the comments `cmts` (not expectations)
saidOf : List Lex.Tok -> List Lex.Tok -> List Lex.Cmt -> Rename -> List String
saidOf toks quals cmts r =
  ("`"
   ^ r.old
   ^ "` -> `"
   ^ r.new
   ^ "`, "
   ^ debug (count (isName r.old) quals)
   ^ " use(s)")
  :: List.append
    (bareSaid
       r
       (count (isName r.old) toks - count (isName r.old) (qualifiers toks)))
    (commentSaid r (count (\(c : Lex.Cmt) -> mentions r.old c.text) cmts))

-- | an alias the table has nothing for, short: one to add to it
shortOf : Import.Import -> List String
shortOf imp =
  maybe
    Nil
    (\a ->
       if strLength a <= 3
          && not (List.any (\p -> strEq (fst p) imp.name) aliases)
       then ["not in the table: `import " ^ imp.name ^ " as " ^ a ^ "`"]
       else Nil)
    imp.alias

-- | why the file is to be left as it is: two imports of one alias, or a
-- | new alias written before a `.` already (a local name's)
problemsOf : List Import.Import -> List Rename -> List Lex.Tok -> List String
problemsOf imps rs quals =
  List.append
    (List.map
       (\a ->
          "two imports would be `" ^ a ^ "`: give one another in `overrides`")
       (dups
          ("List"
           :: justs
             (List.map
                (\(i : Import.Import) ->
                   maybe Nothing (\a -> Just (newOf rs a)) i.alias)
                imps))))
    (List.map
       (\(r : Rename) ->
          "`"
          ^ r.new
          ^ ".` is written here already: give `"
          ^ r.old
          ^ "` another alias in `overrides`")
       (List.keepIf
          (\(r : Rename) ->
             List.any
               (\(t : Lex.Tok) -> strEq t.text r.new && not (oldIn rs t.text))
               quals)
          rs))

-- | the text renamed, unless something is in the way
renamed : String
        -> String
        -> List Import.Import
        -> List Rename
        -> Lex.Lexed
        -> List Lex.Tok
        -> List Lex.Cmt
        -> List String
        -> Done
renamed f src imps rs lexed quals cmts [] =
  { text =
      applyEdits
        src
        (List.append
           (justs (List.map (importEdit f) imps))
           (List.map
              (useEdit rs)
              (List.keepIf (\(t : Lex.Tok) -> oldIn rs t.text) quals)))
  , aliases = List.length rs
  , uses = count (\(t : Lex.Tok) -> oldIn rs t.text) quals
  , said =
      List.append
        (List.concatMap (saidOf lexed.tokens quals cmts) rs)
        (List.concatMap shortOf imps)
  , problems = Nil
  }
renamed f src imps rs lexed quals cmts problems =
  { text = src, aliases = 0, uses = 0, said = Nil, problems = problems }

withQualifiers : String
               -> String
               -> List Import.Import
               -> List Rename
               -> Lex.Lexed
               -> List Lex.Tok
               -> List Lex.Cmt
               -> Done
withQualifiers f src imps rs lexed quals cmts =
  renamed f src imps rs lexed quals cmts (problemsOf imps rs quals)

-- (the qualifiers of the code and of its expectations; the comments
-- that are no expectation)
withLines : String
          -> String
          -> List Import.Import
          -> List Rename
          -> String
          -> Lex.Lexed
          -> List Line
          -> Done
withLines f src imps rs text lexed ls =
  withQualifiers
    f
    src
    imps
    rs
    lexed
    (List.append
       (qualifiers lexed.tokens)
       (List.concatMap (lineQualifiers text) ls))
    (List.keepIf (\(c : Lex.Cmt) -> not (inLines ls c)) lexed.comments)

withLexed : String
          -> String
          -> List Import.Import
          -> List Rename
          -> String
          -> Lex.Lexed
          -> Done
withLexed f src imps rs text lexed =
  withLines
    f
    src
    imps
    rs
    text
    lexed
    (List.concatMap (expectLines text) lexed.tokens)

-- (lexed with its import lines blanked, as the compiler reads it)
withRenames : String -> String -> Import.Imports -> List Rename -> Done
withRenames f src r [] = unchanged src (List.concatMap shortOf r.imports)
withRenames f src r rs = withLexed f src r.imports rs r.text (Lex.lex r.text)

withImports : String -> String -> Import.Imports -> Done
withImports f src r =
  withRenames f src r (justs (List.map (renameOf f) r.imports))

-- | the text of the file `f` renamed
renameText : String -> String -> Done
renameText f src =
  if List.elem f kept then unchanged src Nil
  else withImports f src (Import.readImports src)

-- Markdown: its ```haskell blocks -------------------------------------------

addDone : Done -> Done -> Done
addDone a b =
  { text = a.text ^ b.text
  , aliases = a.aliases + b.aliases
  , uses = a.uses + b.uses
  , said = List.append a.said b.said
  , problems = List.append a.problems b.problems
  }

fence : String
fence = "```haskell\n"

-- (the text from `at` to the end, as it is)
restOf : String -> Int -> Done -> Done
restOf src at acc =
  addDone acc (unchanged (strSlice src at (strLength src)) Nil)

-- (a block, from `b` past its fence to its last line's end `e`, renamed
-- as a file is)
blockAt : String -> String -> Int -> Int -> Done -> Int -> Done
blockAt f src at b acc e =
  addDone
    (addDone acc (unchanged (strSlice src at b) Nil))
    (renameText f (strSlice src b (e + 1)))

-- | each block from `at` on renamed, the text between as it is (a
-- | problem in one block leaves the whole file as it is)
blocksFrom : String -> String -> Int -> Done -> Done
blocksFrom f src at acc =
  maybe
    (restOf src at acc)
    (\b ->
       maybe
         (restOf src at acc)
         (\e ->
            blocksFrom
              f
              src
              (e + 1)
              (blockAt f src at (b + strLength fence) acc e))
         (indexOf "\n```" src (b + strLength fence)))
    (indexOf fence src at)

renameAny : String -> String -> Done
renameAny f src =
  if endsWith ".md" f then blocksFrom f src 0 (unchanged "" Nil)
  else renameText f src

-- The files -----------------------------------------------------------------

world : HFunctor
world = stdio <+> (process <+> filesystem)

-- | what was done: the files changed, the aliases and uses renamed, how
-- | many files were left as they are for a problem
type Tally = { files : List String, aliases : Int, uses : Int, problems : Int }

indented : List String -> String
indented xs = joinWith "" (List.map (\x -> "\n  " ^ x) xs)

problem : Tally -> Tally
problem t =
  { files = t.files
  , aliases = t.aliases
  , uses = t.uses
  , problems = t.problems + 1
  }

tallied : Tally -> String -> Done -> Tally
tallied t f d =
  { files = List.append t.files [f]
  , aliases = t.aliases + d.aliases
  , uses = t.uses + d.uses
  , problems = t.problems
  }

-- | a file renamed: written (unless `check`), and said
written : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> Bool
        -> Tally
        -> String
        -> Done
        -> Co e Tally
written check t f d =
  if not (List.null d.problems)
  then do
    printErr (f ^ ": left as it is" ^ indented d.problems)
    pure (problem t)
  else if d.aliases == 0
  then do
    if List.null d.said then pure MkUnit else printErr (f ^ indented d.said)
    pure t
  else do
    ok <- if check then pure True else Files.writeFile f d.text
    print (f ^ indented d.said)
    if ok then pure (tallied t f d)
    else do
      printErr (f ^ ": not written")
      pure (problem t)

oneFile : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> Bool
        -> Tally
        -> String
        -> Co e Tally
oneFile check t f = do
  read <- Files.readFile f
  maybe
      (do
       printErr (f ^ ": not read")
       pure (problem t))
      (\src -> written check t f (renameAny f src))
      read

eachFile : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{disk : filesystem <: e}}
         -> Bool
         -> Tally
         -> List String
         -> Co e Tally
eachFile check t [] = pure t
eachFile check t (f :: rest) = do
  t2 <- oneFile check t f
  eachFile check t2 rest

-- | the files named, else every .hf file git has and docs/*.md
filesOf : List String -> Ran -> List String
filesOf argv listed =
  if List.null (List.keepIf (\a -> not (startsWith "--" a)) argv)
  then List.keepIf (\l -> strLength l > 0) (lines listed.out)
  else List.keepIf (\a -> not (startsWith "--" a)) argv

-- | the .hf files `heff fmt` lays out, as the Makefile's: not the tests'
laidOut : List String -> List String
laidOut fs =
  List.keepIf (\f -> endsWith ".hf" f && not (startsWith "test/" f)) fs

formatted : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> String
          -> List String
          -> Co e Bool
formatted heff [] = pure True
formatted heff fs = do
  r <- run { command = heff, args = "fmt" :: fs }
  if succeeded r then pure True
  else do
    printErr (heff ^ " fmt failed:\n" ^ r.out ^ r.err)
    pure False

-- | a problem, a format that failed, or with `--check`, a file to change
failed : Bool -> Bool -> Tally -> Bool
failed check laid t =
  t.problems > 0 || not laid || check && not (List.null t.files)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> Co e Unit
program = do
  argv <- args
  listed <- run { command = "git", args = ["ls-files", "*.hf", "docs/*.md"] }
  heffEnv <- getEnv "HEFF"
  t <-
    eachFile
      (List.elem "--check" argv)
      { files = Nil, aliases = 0, uses = 0, problems = 0 }
      (filesOf argv listed)
  laid <-
    if List.elem "--check" argv then pure True
    else formatted (fromMaybe ".heff/out/heff" heffEnv) (laidOut t.files)
  print
      (debug (List.length t.files)
       ^ " file(s), "
       ^ debug t.aliases
       ^ " alias(es), "
       ^ debug t.uses
       ^ " use(s)"
       ^ (if List.elem "--check" argv then " to rename" else " renamed")
       ^ (if t.problems > 0
          then "; " ^ debug t.problems ^ " file(s) left for a problem"
          else ""))
  if failed (List.elem "--check" argv) laid t then exit 1
  else pure MkUnit

main : Co world Unit
main =
  program
    (io := _)
    (sys := _)
    (disk := _)
