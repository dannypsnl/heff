-- The import aliases made words (#60): `import heff.build.driver as Dr`
-- becomes `import heff.build.driver as Driver`, and every `Dr.x` of the
-- file `Driver.x`.  Each module's alias is the table's, `aliases`, below.
--
--   heff run scripts/aliases.hf [--check] [FILE...]
--
-- (from the repository's root: `make aliases`).  No FILE: every .hf file
-- git has, and the ```haskell blocks of docs/*.md.  A use is found by
-- the compiler's own lexer (heff.syntax.fmt.lex): an alias's token with a
-- field right after it, no space between -- so a string, a comment, a
-- name that only starts with the alias, `M` alone (a type, a field), are
-- left as they are; but a watch's or doc test's expectation, the
-- `-- ...` lines under it, is code, and lexed as heff.build.driver
-- reads it.  A file where two imports would have one alias, or
-- where the new alias is written before a `.` already, is left as it is,
-- and said.  The .hf files changed, but the tests' (laid out as they are
-- written, as the Makefile's `fmt` has it), are formatted after, by
-- `heff fmt` (HEFF, else .heff/out/heff).  Run again, it changes nothing.
-- `--check` writes nothing, says what it would change, and fails if
-- anything would.

module scripts.aliases

import co
import heff.syntax.fmt.lex as Lex
import heff.syntax.import as Import
import std.filesystem
import heff.util.files as Files
import std.io
import std.path as Path
import std.process

-- The table ----------------------------------------------------------------

