-- The example pages, one project (`heff build` builds them), and the
-- tests' own apps, each compiled for the page (`heff compile
-- --backend=page`) and used on a pretend page, as a person would --
-- clicked, typed in, time passed -- each a subtest holding what the page
-- then shows to what it should.  The page is Node.js's (an app is JavaScript), the tests'
-- pretend page; what is done and what is wanted are here.  And a page
-- and its server, one project: `heff build` makes the server, through C,
-- and the page's script; the server runs, and the page asks it for the
-- notes, each call over the wire, until it is gone.  And a first
-- program, through C: its tests, its build, and what it prints.
--
--   heff test test/apps.hf
--   heff test --run apps/notes test/apps.hf

module test.apps

import bytes as Bytes
import check
import co
import custodian as Custodian
import exception
import json as JSON
import std.filesystem
import std.path as Path
import std.process
import resource

-- (what the tests run by is given, else the test fails)
given : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> String
      -> Co e String
given name = do
  v <- getEnv name
  case v of
    Just s -> pure s
    Nothing -> failure (name ^ " is not set: `heff test` sets it")

-- (its status, if it exited)
statusOf : Ended -> String
statusOf (Exited n) = "status " ^ debug n
statusOf (Signalled n) = "signal " ^ debug n
statusOf TimedOut = "timed out"
statusOf (NotRun err) = "not run: " ^ show err

-- | how a command ended, and what it said
said : Ran -> String
said r = statusOf r.ended ^ "\n" ^ r.out ^ r.err

-- | what the page said, each what was looked at and what it showed
shown : String -> List (Pair String String)
shown out =
  List.map
    (\l -> case JSON.parse l of
     Right j ->
       MkPair
         (fromMaybe "" (JSON.str ["what"] j))
         (fromMaybe "" (JSON.str ["got"] j))
     Left err -> MkPair "said" l)
    (List.keepIf (\l -> not (strEq (trim l) "")) (lines out))

-- | how what the page showed is not what was wanted
-- | >>> unlike [MkPair "a" "1"] [MkPair "a" "2"]
-- | ["a: \"2\", wanted \"1\""]
unlike : List (Pair String String) -> List (Pair String String) -> List String
unlike want got =
  List.append
    (List.concatMap
       (\w -> case List.find (\g -> strEq (fst g) (fst w)) got of
        Just g ->
          if strEq (snd g) (snd w) then Nil
          else [fst w ^ ": " ^ debug (snd g) ^ ", wanted " ^ debug (snd w)]
        Nothing -> [fst w ^ ": not shown"])
       want)
    (List.concatMap
       (\g ->
          if List.any (\w -> strEq (fst w) (fst g)) want then Nil
          else [fst g ^ ": " ^ debug (snd g) ^ ", not wanted"])
       got)

-- (the test fails, saying each of these, unless there are none)
failingWith : {e : HFunctor}
            -> {{chk : check <: e}}
            -> List String
            -> Co e Unit
failingWith [] = pure MkUnit
failingWith msgs = failure (joinWith "\n" msgs)

-- | an app for the page: its source, the definition it runs, and its
-- | script's name
-- | an app: its source, the definition it runs, its name, and what more
-- | `heff compile` is told (`--fuel`)
type App =
  { source : String, entry : String, name : String, flags : List String = [] }

-- | a test's app, by its source and its name, the definition it runs
testApp : String -> String -> App
testApp source name = { source = source, entry = name, name = name }

-- | an example page, by its name: the program `main` of the pages'
-- | project
example : String -> App
example n =
  { source = "examples/pages/app/" ^ n ^ "/main.hf", entry = "main", name = n }

-- | an app compiled for the page: its script, in the working directory
compiled : {e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> App
         -> Co e String
compiled app = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  working <- workingDir
  let here = show working
  out <- pure (here ^ "/" ^ app.name ^ ".js")
  r <-
    run
      { command = heff
      , args =
          List.append
            ["compile", app.source, out, "--name", app.entry, "--backend=page"]
            app.flags
      , dir = root
      , timeout = 120000
      }
  if succeeded r then pure out else failure ("not compiled: " ^ said r)

-- (each compiled)
allCompiled : {e : HFunctor}
            -> {{chk : check <: e}}
            -> {{sys : process <: e}}
            -> List App
            -> Co e (List String)
allCompiled [] = pure Nil
allCompiled (a :: rest) = do
  s <- compiled a
  ss <- allCompiled rest
  pure (s :: ss)

-- | apps on the pretend page as `scene` says, what it shows held to
-- | what is wanted
onPage : {e : HFunctor}
       -> {{chk : check <: e}}
       -> {{sys : process <: e}}
       -> String
       -> List App
       -> List (Pair String String)
       -> Co e Unit
onPage scene apps want = do
  root <- given "HEFF_TEST_ROOT"
  scripts <- allCompiled apps
  r <-
    run
      { command = "node"
      , args = (root ^ "/test/page.mjs") :: scene :: scripts
      , timeout = 60000
      }
  if succeeded r then failingWith (unlike want (shown r.out))
  else failure (said r)

-- | the example pages, one project: `heff build` builds each page's
-- | script
builtPages : {e : HFunctor}
           -> {{chk : check <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{fx : exception FileError <: e}}
           -> Co e Unit
builtPages = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/pages")
  r <- run { command = heff, args = ["build"], dir = dir, timeout = 300000 }
  scripts <- readDirectory (dir ^ "/.heff/bin")
  if not (succeeded r) then failure ("heff build: " ^ said r)
  else assertEqual
      (List.sort (List.map Path.basename scripts))
      ["clock.js", "counter.js", "greet.js", "pixels.js", "vecadd.js"]

-- (the kernel `vecAdd` is, as WGSL)
kernel : String
kernel =
  joinWith
    "\n"
    [ "@group(0) @binding(0) var<storage, read> a : array<f32>;"
    , "@group(0) @binding(1) var<storage, read> b : array<f32>;"
    , "@group(0) @binding(2) var<storage, read_write> c : array<f32>;"
    , "@compute @workgroup_size(64)"
    , "fn add(@builtin(global_invocation_id) id : vec3<u32>) {"
    , "  let v0 = id.x;"
    , "  if (v0 < arrayLength(&c)) {"
    , "    c[v0] = a[v0] + b[v0];"
    , "  }"
    , "}"
    ]

-- (the kernel `gradient` is, as WGSL)
gradient : String
gradient =
  joinWith
    "\n"
    [ "@group(0) @binding(0) var<storage, read_write> a : array<u32>;"
    , "@compute @workgroup_size(64)"
    , "fn shade(@builtin(global_invocation_id) id : vec3<u32>) {"
    , "  let v0 = id.x;"
    , "  if (v0 < arrayLength(&a)) {"
    , "    let v1 = v0 % 64u;"
    , "    let v2 = v0 / 64u;"
    , "    a[v0] = (((v1 * 255u) / 64u) + (((v2 * 255u) / 64u) * 256u)) + 4278190080u;"
    , "  }"
    , "}"
    ]

-- (what the fuel program says, test/node/fuel-program.hf's: the same
-- on the C backend, test/backends.hf's, and in JavaScript, test/apps.hf's)
fuelSaid : String
fuelSaid =
  "a pure loop stopped: Nothing\nfinished within its fuel: Just 5050\n"
  ^ "the inner out of its own: Just \"Nothing then 5050\"\n"
  ^ "the inner out of the outer's: Nothing\n"
  ^ "after them, unlimited: 500000500000\n"
  ^ "a loop calling itself: near its rounds\n"
  ^ "a loop in a loop's rounds: near its rounds\n"
  ^ "a closure called each round: near its rounds\n"
  ^ "a loop called each round: near its rounds\n"
  ^ "calling one another last: near its rounds\n"
  ^ "calling one another, not last: near its rounds\n"
  ^ "a loop after a limit inside run out: near its rounds"

-- | each app on its page, a subtest each
pages : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> Co e Unit
pages = do
  subtest "built" builtPages
  subtest
      "counter"
      (onPage
         "counter"
         [example "counter"]
         [ MkPair "at first" "count: 0"
         , MkPair "after 3 clicks" "count: 3"
         , MkPair "after -1" "count: 2"
         ])
  subtest
      "clock"
      (onPage
         "clock"
         [example "clock"]
         [MkPair "at first" "0 ticks", MkPair "after 5 ticks" "5 ticks"])
  -- (elements already on the page, found by a CSS selector and an XPath)
  subtest
      "finder"
      (onPage
         "finder"
         [testApp "test/apps/select.hf" "finder"]
         [ MkPair "by css" "found by css"
         , MkPair "by xpath" "found by xpath"
         , MkPair "elements" "2"
         ])
  -- (an app whose effect is a definition, `page = dom <+> state Int`)
  subtest
      "aliased"
      (onPage
         "aliased"
         [testApp "test/apps/aliased.hf" "aliased"]
         [MkPair "out" "42"])
  -- (boc in JavaScript's one thread: test/node/cowns-program.hf, the
  -- same lines as on the C backend's threads, test/backends.hf's)
  subtest
      "cowns"
      (onPage
         "cowns"
         [testApp "test/apps/cowns.hf" "cowns"]
         [ MkPair
           "out"
           ("added by 1000: 1000\naccounts: 600 -150 100 -150 400\n"
            ^ "in the order spawned: yes\nnested: 2 6\n"
            ^ "a failing behaviour: 2 added by the others\n"
            ^ "kept in a long body's slot: run, before its end where another thread is\n"
            ^ "waiting for their turns: 1 2 3 4 5\nwaiting on one of two: 2 3\n"
            ^ "a condition never holding: its body never ran\n"
            ^ "a name holding two cowns: 0 1 2 0\n"
            ^ "an array in a cown: 1 0 0 4, given on by a body that failed: 7, a write not kept: 1 0 3 0, one read: 9, given on: 5, strings: a b\n"
            ^ "an array in a pair in a cown: 1 0 5 and 0, given on by a body that failed: 7\n"
            ^ "parMap, in order: 1 4 9 16 25 36, of none: 0\n"
            ^ "a pattern bound: 1 24, read 13")
         ])
  -- (std.fuel's `limited` in JavaScript: test/node/fuel-program.hf,
  -- the same lines as on the C backend's, test/backends.hf's)
  subtest
      "fuel"
      (onPage
         "fuel"
         [{ (testApp "test/apps/fuel.hf" "fuel") | flags = ["--fuel"] }]
         [MkPair "out" fuelSaid])
  -- (std.fuel's `limited` across a sleep and a behaviour of boc's
  -- spawned, in JavaScript: test/node/fuel-async-program.hf, as on the
  -- C backend)
  subtest
      "fuel-async"
      (onPage
         "fuel-async"
         [ { (testApp "test/apps/fuel-async.hf" "fuelAsync")
           | flags = ["--fuel"]
           }
         ]
         [ MkPair
           "out"
           ("a pure loop after a sleep: Nothing\na loop after a sleep within its fuel: Just 1000\n"
            ^ "a pure loop after a behaviour spawned: Nothing\na behaviour spawned in a limit, with none: Just 500000500000\n"
            ^ "the least fuel of a loop after a sleep: near its rounds")
         ])
  -- (std.time beside the page's world, its provider the page's too)
  subtest
      "slept"
      (onPage
         "slept"
         [testApp "test/apps/slept.hf" "slept"]
         [ MkPair "before the time has passed" "sleeping"
         , MkPair "after" "slept"
         ])
  -- (std.time's clocks, read by its provider on the page)
  subtest
      "clocked"
      (onPage
         "clocked"
         [testApp "test/apps/clocked.hf" "clocked"]
         [MkPair "out" "after 2026: True, not fewer: True"])
  -- (a world of the test's own beside the page's, each acting on what
  -- the other's provider handed out: the host's own objects, by value)
  subtest
      "painted"
      (onPage
         "painted"
         [testApp "test/apps/paint.hf" "painted"]
         [ MkPair "class" "red"
         , MkPair "its stamp" "mark: stamped"
         , MkPair "found again" "yes"
         ])
  -- (a `JSString` field of an operation: a JavaScript string to the
  -- provider, its length its text's UTF-16 code units, not its bytes)
  subtest
      "texts"
      (onPage
         "texts"
         [testApp "test/apps/jstext.hf" "texts"]
         [ MkPair
           "out"
           "5 bytes, 5 code units: plain\n7 bytes, 4 code units: é😀a\n3 bytes, 3 code units: x\u{FFFD}y"
         ])
  -- (an app whose definitions have the names of the window's own)
  subtest
      "names"
      (onPage
         "names"
         [testApp "test/apps/names.hf" "names"]
         [MkPair "out" "top name status self parent"])
  subtest
      "greet"
      (onPage
         "greet"
         [example "greet"]
         [ MkPair "at first" "Hello, whoever you are."
         , MkPair "after typing" "Hello, Ada!"
         ])
  -- (two apps on one page, each keeping what it defines to itself)
  subtest
      "two apps"
      (onPage
         "two"
         [example "counter", example "clock"]
         [MkPair "the counter" "count: 1", MkPair "the clock" "1 ticks"])
  -- (a GPU, WebGPU's: where there is none, the page says so; on a
  -- pretend one, the provider's wiring, its kernel the example's
  -- `vecAdd` as WGSL; a real GPU is checked by hand)
  subtest
      "vecadd"
      (onPage
         "vecadd"
         [example "vecadd"]
         [ MkPair "no WebGPU" "gpu: WebGPU is not here"
         , MkPair "on a pretend GPU" "ok"
         , MkPair "its dispatch" "add 16 1 1"
         , MkPair "its kernel" kernel
         , MkPair "its buffers let go of" "true,true,true,true"
         ])
  -- (a canvas the DOM made, given to the GPU's canvas effect inside the
  -- same `with`s: on a pretend GPU, the kernel over the pixels, and the
  -- buffer copied onto the canvas, configured for the device)
  subtest
      "pixels"
      (onPage
         "pixels"
         [example "pixels"]
         [ MkPair "no WebGPU" "gpu: WebGPU is not here"
         , MkPair "drawn" "drawn"
         , MkPair "its dispatch" "shade 64 1 1"
         , MkPair "its kernel" gradient
         , MkPair
           "on the canvas"
           "canvas 64x64 rgba8unorm, 16384 bytes, pixel 1: 1,0,0,0"
         , MkPair "its buffers let go of" "true"
         ])

-- (lines read from the page until it says to lose the server)
readUntilLost : {e : HFunctor}
              -> {s : Type}
              -> {{sys : process <: e}}
              -> With s Started
              -> String
              -> Co e String
readUntilLost p sofar = do
  l <- readOutput p (Through "\n") 60000
  case l of
    Got b ->
      if contains "lose the server" (Bytes.asString b)
      then pure (sofar ^ Bytes.asString b)
      else readUntilLost p (sofar ^ Bytes.asString b)
    _ -> pure sofar

-- | the notes, a page and its server: its API's test first, the calls
-- | through the wire with no network; then built, the server run, and
-- | its page asking it, on two pages; a call of another build of the
-- | API refused, and why; the server gone, a call's failure said on the
-- | page
notes : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> {{disk : filesystem <: e}}
      -> {{cu : Custodian.custodian <: e}}
      -> Co e Unit
notes = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/notes")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  ports <-
    run
      { command = "node"
      , args = [root ^ "/test/peers.mjs", "ports", "1"]
      , timeout = 30000
      }
  port <- pure (trim ports.out)
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
  else if not (succeeded built) then failure ("heff build: " ^ said built)
  else do
    all <-
      withProcess
        { command = dir ^ "/.heff/bin/server"
        , args = [port]
        , dir = dir
        , timeout = 120000
        }
        (\server ->
           withProcess
             { command = "node"
             , args =
                 [ root ^ "/test/page.mjs"
                 , "notes"
                 , "http://127.0.0.1:" ^ port
                 ]
             , input = Piped
             , output = Piped
             , timeout = 120000
             } (\page -> do
               before <- readUntilLost page ""
               gone <- terminate server
               ok <- writeInput page (Bytes.fromString "\n")
               r <- wait page
               pure (before ^ r.out)))
    failingWith
        (unlike
           [ MkPair "served" "true"
           , MkPair "as the server has them" "[ ] milk|[ ] bread"
           , MkPair "on another page" "[x] milk|[ ] bread"
           , MkPair "another build" "hw 1 2 1"
           , MkPair "why" "true"
           , MkPair "lose the server" ""
           , MkPair "a call to no server" "true"
           , MkPair "as they were" "[x] milk|[ ] bread"
           , MkPair "stray rejections" ""
           ]
           (shown all))

-- | the first program: its tests, then built, through C, and run on
-- | some numbers, what it printed held to what it should
collatz : {e : HFunctor}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
collatz = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/collatz")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
  else if not (succeeded built) then failure ("heff build: " ^ said built)
  else do
    r <-
      run
        { command = dir ^ "/.heff/bin/collatz"
        , args = ["3", "x", "0", "6"]
        , dir = dir
        , timeout = 60000
        }
    assertEqual
        (said r)
        "status 0\n3: 7 steps\n0: never comes to 1\nmost steps: 7\n"

-- | the todos: tested (the app on keys given) and built
todos : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> Co e Unit
todos = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/todos")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
  else if not (succeeded built) then failure ("heff build: " ^ said built)
  else pure MkUnit

-- | fs_tree: tested, built, and run on a directory made here, what it
-- | drew held to what `tree` draws
fsTree : {e : HFunctor}
       -> {{chk : check <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> Co e Unit
fsTree = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/fs_tree")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
  else if not (succeeded built) then failure ("heff build: " ^ said built)
  else do
    makeDirectory "demo/src/lib"
    makeDirectory "demo/docs"
    writeFile "demo/README.md" ""
    writeFile "demo/src/main.hf" ""
    writeFile "demo/src/lib/a.hf" ""
    writeFile "demo/docs/guide.md" ""
    r <-
      run
        { command = dir ^ "/.heff/bin/fs_tree"
        , args = ["demo", "-L", "2"]
        , timeout = 60000
        }
    assertEqual
        (said r)
        "status 0\ndemo\n├── docs\n│\u{a0}\u{a0} └── guide.md\n├── README.md\n└── src\n    ├── lib\n    └── main.hf\n\n4 directories, 3 files\n"

-- | touch: built, and run on a path to make, one already there and one
-- | in no directory, that one said and touch failing
touch : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> Co e Unit
touch = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/touch")
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded built) then failure ("heff build: " ^ said built)
  else do
    writeFile "kept" "as it was"
    r <-
      run
        { command = dir ^ "/.heff/bin/touch"
        , args = ["made", "kept", "missing/file"]
        , timeout = 60000
        }
    made <- readFile "made"
    kept <- readFile "kept"
    assertEqual
        (said r ^ "made: " ^ debug made ^ ", kept: " ^ debug kept)
        "status 1\ntouch: missing/file: ENOENT: No such file or directory\nmade: \"\", kept: \"as it was\""

-- | the rooms, a server on boc's cowns: built
rooms : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> Co e Unit
rooms = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/rooms")
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded built) then failure ("heff build: " ^ said built)
  else pure MkUnit

-- | an effect of one operation, a C function's, `module name`: the
-- | function described with its header, `header`, and what the module's
-- | C needs, `links` (ffi's `Links`, as written)
cBound : String
       -> String
       -> String
       -> String
       -> String
       -> List String
       -> String
cBound name header fun args result links =
  joinWith
    "\n"
    [ "module " ^ name
    , ""
    , "import co"
    , "import ffi as FFI"
    , ""
    , "data BoundF (m : Type -> Type) x = Call "
    ^ args
    ^ " ("
    ^ result
    ^ " -> x)"
    , ""
    , "bound : HFunctor"
    , "bound ="
    , "  { f = BoundF"
    , "  , hfmap = \\m g p -> case p of"
    , "      Call "
    ^ (if strEq args "" then "" else "a ")
    ^ "k -> Call "
    ^ (if strEq args "" then "" else "a ")
    ^ "(\\r -> g (k r))"
    , "  , hmap = \\m n nt p -> case p of"
    , "      Call "
    ^ (if strEq args "" then "" else "a ")
    ^ "k -> Call "
    ^ (if strEq args "" then "" else "a ")
    ^ "k"
    , "  }"
    , ""
    , "boundInC : FFI.Described"
    , "boundInC = FFI.describe [\""
    ^ header
    ^ "\"] [FFI.operation \"Call\" "
    ^ fun
    ^ "]"
    , ""
    , "boundLinks : FFI.Links"
    , "boundLinks = " ^ joinWith "\n" links
    , ""
    , "call : {e : HFunctor} -> {{b : bound <: e}} -> "
    ^ (if strEq args "" then "" else args ^ " -> ")
    ^ "Co e "
    ^ result
    , "call "
    ^ (if strEq args "" then "" else "a ")
    ^ "= op (b (Call "
    ^ (if strEq args "" then "" else "a ")
    ^ "(\\r -> r))) val"
    , ""
    ]

-- | a program, `module name`, that prints what `body` makes of the
-- | module `bound`'s `call`
boundMain : String -> String -> String -> String
boundMain name bound body =
  joinWith
    "\n"
    [ "module " ^ name
    , ""
    , "import co"
    , "import std.io"
    , "import " ^ bound ^ " as Bound"
    , ""
    , "main : Co (Bound.bound <+> stdio) Unit"
    , "main = do"
    , "  r <- Bound.call" ^ body
    , ""
    ]

-- (a program's build.hf, the C compiler told where else to look)
linkedBuild : String
linkedBuild =
  joinWith
    "\n"
    [ "import manifest"
    , ""
    , "build : Build"
    , "build ="
    , "  { backend = C"
    , "  , run = \"main\""
    , "  , includeDirs = [\"vendor/include\"]"
    , "  , libDirs = [\"vendor/lib\"]"
    , "  }"
    , ""
    ]

-- (the library `twice`, a static one, built here by zig: its header in
-- vendor/include, the library in vendor/lib; else the test fails)
twiceBuilt : {e : HFunctor}
           -> {{chk : check <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{fx : exception FileError <: e}}
           -> Co e Unit
twiceBuilt = do
  makeDirectory "vendor/include"
  makeDirectory "vendor/lib"
  writeFile
      "vendor/include/twice.h"
      "#include <stdint.h>\nint64_t twice_of(int64_t n);\n"
  writeFile
      "vendor/twice.c"
      "#include \"twice.h\"\nint64_t twice_of(int64_t n) { return 2 * n; }\n"
  o <-
    run
      { command = "zig"
      , args =
          [ "cc"
          , "-O2"
          , "-c"
          , "-Ivendor/include"
          , "vendor/twice.c"
          , "-o"
          , "vendor/twice.o"
          ]
      , timeout = 120000
      }
  a <-
    if succeeded o
    then run
        { command = "zig"
        , args = ["ar", "rcs", "vendor/lib/libtwice.a", "vendor/twice.o"]
        , timeout = 60000
        }
    else pure o
  if succeeded a then pure () else failure ("the library: " ^ said a)

-- | a program built with a library that is not the runtime's: its
-- | module says what its C needs (ffi's `Links`) -- a static library
-- | built here, its header included from a directory of the build.hf's,
-- | linked from another; on macOS a framework, CoreFoundation's clock --
-- | and, where there is pkg-config, `heff run` of one whose module names
-- | the library by its package, found by pkg-config
linked : {e : HFunctor}
       -> {{chk : check <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> Co e Unit
linked = do
  heff <- given "HEFF"
  os <- platform
  here <- workingDir
  twiceBuilt
  makeDirectory "src"
  makeDirectory "app/twice"
  writeFile
      "package.hf"
      "import manifest\n\npackage : Package\npackage = { module = \"linked\", heff = \"0.6.1\" }\n"
  writeFile
      "src/twice.hf"
      (cBound
         "twice"
         "<twice.h>"
         "(FFI.fun \"twice_of\" [FFI.int64] (FFI.gives FFI.int64))"
         "Int"
         "Int"
         ["{ libs = [\"twice\"] }"])
  writeFile "app/twice/build.hf" linkedBuild
  writeFile
      "app/twice/main.hf"
      (boundMain
         "app.twice.main"
         "twice"
         " 21\n  print (\"twice 21: \" ^ debug r)")
  if strEq os "darwin"
  then do
    makeDirectory "app/clock"
    writeFile
        "src/clock.hf"
        (cBound
           "clock"
           "<CoreFoundation/CoreFoundation.h>"
           "(FFI.fun \"CFAbsoluteTimeGetCurrent\" [] (FFI.gives FFI.double))"
           ""
           "Float64"
           ["{ frameworks = [\"CoreFoundation\"] }"])
    writeFile
        "app/clock/build.hf"
        "import manifest\n\nbuild : Build\nbuild = { backend = C, run = \"main\" }\n"
    writeFile
        "app/clock/main.hf"
        (boundMain
           "app.clock.main"
           "clock"
           "\n  print (if r > 8.0e8 then \"since 2001: yes\" else \"since 2001: no\")")
  else pure ()
  built <- run { command = heff, args = ["build"], timeout = 600000 }
  if succeeded built then pure () else failure ("heff build: " ^ said built)
  r <- run { command = ".heff/bin/twice", timeout = 60000 }
  assertEqual (said r) "status 0\ntwice 21: 42\n"
  if strEq os "darwin"
  then do
    c <- run { command = ".heff/bin/clock", timeout = 60000 }
    assertEqual (said c) "status 0\nsince 2001: yes\n"
  else pure ()
  pc <- run { command = "pkg-config", args = ["--version"], timeout = 60000 }
  if succeeded pc
  then do
    makeDirectory "pc"
    writeFile
        "vendor/twice.pc"
        ("prefix="
         ^ show here
         ^ "/vendor\nName: twice\nDescription: twice\nVersion: 1.0.0\n"
         ^ "Cflags: -I${prefix}/include\nLibs: -L${prefix}/lib -ltwice\n")
    writeFile
        "src/viapc.hf"
        (cBound
           "viapc"
           "<twice.h>"
           "(FFI.fun \"twice_of\" [FFI.int64] (FFI.gives FFI.int64))"
           "Int"
           "Int"
           ["{ pkgConfig = [\"twice\"] }"])
    writeFile
        "pc/main.hf"
        (boundMain "pc.main" "viapc" " 4\n  print (\"twice 4: \" ^ debug r)")
    v <-
      run
        { command = heff
        , args = ["run", "pc/main.hf"]
        , env = [MkPair "PKG_CONFIG_PATH" (show here ^ "/vendor")]
        , timeout = 600000
        }
    assertEqual (said v) "status 0\ntwice 4: 8\n"
  else pure ()

-- | the example apps, on a pretend page, the notes' page and server, the
-- | first program, the todos, fs_tree, touch and the rooms, and a
-- | program linked with a library
apps : Test
apps =
  group
    "apps"
    [ integration "pages" pages
    , withinTime 600000 (integration "notes" notes)
    , withinTime 600000 (integration "collatz" collatz)
    , withinTime 600000 (integration "todos" todos)
    , withinTime 600000 (integration "fs_tree" fsTree)
    , withinTime 600000 (integration "touch" touch)
    , withinTime 600000 (integration "rooms" rooms)
    , withinTime 600000 (integration "linked" linked)
    ]
