-- What the tests of `boc` run, on every backend: the same program, by
-- boc, the runtime's effect, on the C backend's threads
-- (test/node/cowns.hf) and in JavaScript's one thread
-- (test/apps/cowns.hf), the same lines said.  A counter many behaviours
-- add to; money moved round accounts, two cowns a behaviour; behaviours
-- on one cown in the order they were spawned; a behaviour spawned in a
-- behaviour's body, on its cown and another; a behaviour that fails
-- among others on its cown, said on stderr; one spawned on a free cown
-- in a body that goes on long after; behaviours waiting (`with ...
-- where`) until their condition holds, and one whose condition never
-- does; a `with` whose name holds two cowns; an array a cown holds,
-- written by bodies that fail, that do not write the cown, and that give
-- it to another behaviour; one a pair in a cown holds, by bodies that
-- fail, give it on, and read the pair after; `parMap`'s values, in
-- order; a `with` on one cown twice, a failure said as it is spawned,
-- the behaviour spawning it going on; and how many threads the pool
-- has.  Each part is started by the one before it, once that one's
-- line is put: what its cowns hold, once every behaviour of it is done,
-- is put in a line by a behaviour on them and on the lines, spawned
-- after those -- or waiting until they hold what the last writes -- and
-- the lines are said by a last one.  The bodies are of the program's
-- world: no cell outside the cowns is needed to read out.

module test.node.cowns-program

import array as Array
import boc as BOC
import co

-- (what the cowns hold made a line, put on the lines, and then the
-- next part started: by a behaviour on both, spawned after those of the
-- part on the cowns)
line : {c : Type}
     -> {e : HFunctor}
     -> BOC.Cown (List String)
     -> c
     -> {{cw : BOC.Cowns c}}
     -> {{bc : BOC.boc <: e}}
     -> (cw.Contents -> String)
     -> Co e Unit
     -> Co e Unit
line ls cs f next =
  BOC.when (ls, cs) (\p -> case p of
    (l, v) -> do
      next
      pure (f v :: l, v))

-- (... spawned by a behaviour on `hop`, spawned after those of the part
-- on it: so after what their bodies spawned too)
lineAfter : {c h : Type}
          -> {e : HFunctor}
          -> BOC.Cown h
          -> BOC.Cown (List String)
          -> c
          -> {{cw : BOC.Cowns c}}
          -> {{bc : BOC.boc <: e}}
          -> (cw.Contents -> String)
          -> Co e Unit
          -> Co e Unit
lineAfter hop ls cs f next =
  BOC.when hop (\x -> do
    line ls cs (cw := cw) f next
    pure x)

-- (`s` put on the lines, and then the next part started, by a behaviour
-- on them)
put : {e : HFunctor}
    -> {{bc : BOC.boc <: e}}
    -> BOC.Cown (List String)
    -> String
    -> Co e Unit
    -> Co e Unit
put ls s next =
  BOC.when ls (\l -> do
    next
    pure (s :: l))

-- (the parts, each started by the one before it once its line is put;
-- after the last, `last`)
chained : {e : HFunctor}
        -> List (Co e Unit -> Co e Unit)
        -> Co e Unit
        -> Co e Unit
chained [] last = last
chained (p :: ps) last = p (chained ps last)

-- (`k` behaviours, each adding 1, a `with` of the cown)
adding : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> BOC.Cown Int
       -> Int
       -> Co e Unit
adding c 0 = pure ()
adding c k = do
  with n := c do
    n := n + 1
  adding c (k - 1)

-- | 1000 behaviours on one cown, each adding 1
counted : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> Co e (BOC.Cown Int)
counted = do
  c <- BOC.newCown 0
  adding c 1000
  pure c

-- (`n` moved from one account to the next: a behaviour on both, a
-- `with` of the two)
moved : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> BOC.Cown Int
      -> BOC.Cown Int
      -> Int
      -> Co e Unit
moved from to n = do
  with x := from
       y := to do
    x := x - n
    y := y + n

-- (`k` rounds of moves round the four accounts)
rounds : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> BOC.Cown Int
       -> BOC.Cown Int
       -> BOC.Cown Int
       -> BOC.Cown Int
       -> Int
       -> Co e Unit
rounds a b c d 0 = pure ()
rounds a b c d k = do
  moved a b 1
  moved b c 2
  moved c d 3
  moved d a 4
  moved a c 1
  rounds a b c d (k - 1)

-- | four accounts of 100, 250 rounds of moves among them
accounts : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> Co
           e
           (BOC.Cown Int, BOC.Cown Int, BOC.Cown Int, BOC.Cown Int)
accounts = do
  a <- BOC.newCown 100
  b <- BOC.newCown 100
  c <- BOC.newCown 100
  d <- BOC.newCown 100
  rounds a b c d 250
  pure (a, b, c, d)

-- (behaviours `i` to `n`, each putting its number on the list)
logged : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> BOC.Cown (List Int)
       -> Int
       -> Int
       -> Co e Unit
logged c i n =
  if i > n then pure ()
  else do
    BOC.when c (\xs -> pure (i :: xs))
    logged c (i + 1) n

-- | 100 behaviours on one cown, each putting its number on a list: in
-- | the order they were spawned
ordered : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> Co e (BOC.Cown (List Int))
ordered = do
  c <- BOC.newCown Nil
  logged c 1 100
  pure c

-- | a behaviour on `a` spawning one on `a` and `b`, which comes after
-- | it on `a`: 1 then doubled, and 1 added to `b` of 5
nested : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> Co e (BOC.Cown Int, BOC.Cown Int)
nested = do
  a <- BOC.newCown 0
  b <- BOC.newCown 5
  BOC.when a (\x -> do
    BOC.when (a, b) (\(x, y) -> pure (x * 2, y + 1))
    pure (x + 1))
  pure (a, b)

-- | three behaviours on one cown of 0: 1 added, the second panics,
-- | 1 added -- the one that failed leaves the cown as it was, the
-- | others run: 2
failing : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> Co e (BOC.Cown Int)
failing = do
  c <- BOC.newCown (0 : Int)
  BOC.when c (\n -> pure (n + 1))
  BOC.when c (\n -> if n == 1 then panic "at 1" else pure (n + 100))
  BOC.when c (\n -> pure (n + 1))
  pure c

-- (how many behaviours the long body spawns at most)
longBound : Int
longBound = 100000

-- (the long body's behaviours from the `i`th, each adding 1 to `z`)
spawnedOn : {e : HFunctor}
          -> {{bc : BOC.boc <: e}}
          -> BOC.Cown Int
          -> Int
          -> Co e Unit
spawnedOn z i =
  if i >= longBound then pure ()
  else do
    BOC.when z (\n -> pure (n + 1))
    spawnedOn z (i + 1)

-- | a behaviour spawned on a free cown in a body that goes on long
-- | after, spawning behaviours on another: kept by the body's thread, and
-- | let out to another, where one is, before the body ends.  It spawns
-- | one on the other cown too, which comes after those spawned on it
-- | before, and reads how many have run, written to the cown given back,
-- | -1 until then: fewer than all of them where it ran before the end
kept : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> Co e (BOC.Cown Int)
kept = do
  a <- BOC.newCown 0
  b <- BOC.newCown 0
  z <- BOC.newCown 0
  seenAt <- BOC.newCown (0 - 1)
  BOC.when a (\x -> do
    BOC.when b (\y -> do
      BOC.when (z, seenAt) (\p -> case p of
        (n, s) -> pure (n, n))
      pure (y + 1))
    spawnedOn z 0
    pure x)
  pure seenAt

-- (behaviour `i` of `n` on the cown of the turn and the numbers come:
-- waiting until the turn is its own, then its number put on the list
-- and the turn the next's)
turned : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> BOC.Cown (Int, List Int)
       -> Int
       -> Co e Unit
turned c i = do
  with t := c once fst t == i do
    t := (i + 1, i :: snd t)

-- (behaviours `i` down to 1, spawned in that order)
turnsFrom : {e : HFunctor}
          -> {{bc : BOC.boc <: e}}
          -> BOC.Cown (Int, List Int)
          -> Int
          -> Co e Unit
turnsFrom c 0 = pure ()
turnsFrom c i = do
  turned c i
  turnsFrom c (i - 1)

-- | five behaviours on one cown, spawned the last first, each waiting
-- | (`where`) for its turn: their numbers in the order of the turns
inTurn : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> Co e (BOC.Cown (Int, List Int))
inTurn = do
  c <- BOC.newCown (1, Nil)
  turnsFrom c 5
  pure c

-- | a behaviour on two cowns waiting until the first holds more than
-- | 0, its condition reading it alone: 1 added to the second meanwhile,
-- | then 2 set in the first; it adds the first to the second, and puts
-- | what they hold then in the third
waitingOnOne : {e : HFunctor}
             -> {{bc : BOC.boc <: e}}
             -> Co e (BOC.Cown (Int, Int))
waitingOnOne = do
  x <- BOC.newCown 0
  y <- BOC.newCown 0
  out <- BOC.newCown (0, 0)
  with a := x
       b := y
       once a > 0 do
    b := b + a
    BOC.when out (\o -> pure (a, b))
  with b := y do
    b := b + 1
  with a := x do
    a := 2
  pure out

-- | a behaviour whose condition never holds: let go of each time the
-- | cown is written, and dropped at the program's end -- its body never
-- | run, and the program ends
neverHeld : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> Co e (BOC.Cown Bool)
neverHeld = do
  c <- BOC.newCown 0
  ran <- BOC.newCown False
  with n := c once n < 0 do
    BOC.when ran (\r -> pure True)
  adding c 3
  pure ran

-- | a `with` of four cowns by three names, the middle one bound to two
-- | of them, its body setting that name alone: both of its cowns
-- | written, the others not
spread : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> Co
         e
         (BOC.Cown Int, BOC.Cown Int, BOC.Cown Int, BOC.Cown Int)
spread = do
  c0 <- BOC.newCown 0
  c1 <- BOC.newCown 0
  c2 <- BOC.newCown 0
  c3 <- BOC.newCown 0
  with a := c0
       b := (c1, c2)
       c := c3 do
    b := (1, 2)
  pure (c0, c1, c2, c3)

-- (the array's numbers)
numbers : Array Int -> List Int
numbers a =
  List.map
    (\i -> fromMaybe 0 (Array.index a i))
    (List.range 0 (Array.length a - 1))

-- (... its strings)
strings : Array String -> List String
strings a =
  List.map
    (\i -> fromMaybe "" (Array.index a i))
    (List.range 0 (Array.length a - 1))

-- | an array of four 0s in a cown, which a body may write in place: 1
-- | at 0, written; 2 at 1, by a body that then fails; 7 at 2, by a body
-- | that gives it to a behaviour on another cown, which puts what it
-- | holds at 2 in a cown, and then fails; 3 at 2, by a `with` that does
-- | not write the cown but puts what it made in a cown; 9 at 3, by one
-- | that only reads what it made; 4 at 3, written, by a body that gives
-- | it to a behaviour on the other cown too, which adds what it holds
-- | at 0 and 3.  The cown then holds 1 0 0 4; the others, 7 and 1 0 3 0;
-- | the one read, 9; the other cown, 5.  And strings, `a b`, written as
-- | they are, then the first made `x` by a body that then fails
arrays : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> Co
         e
         ( BOC.Cown (Array Int)
         , BOC.Cown (Array String)
         , BOC.Cown Int
         , BOC.Cown (Array Int)
         , BOC.Cown Int
         , BOC.Cown Int
         )
arrays = do
  c <- BOC.newCown (Array.replicate 4 (0 : Int))
  s <- BOC.newCown (Array.fromList ["a", "b"])
  d <- BOC.newCown (0 : Int)
  madeOut <- BOC.newCown (Array.replicate 0 (0 : Int))
  readAt <- BOC.newCown 0
  givenOut <- BOC.newCown 0
  BOC.when c (\a -> pure (Array.set a 0 1))
  BOC.when c (\a -> do
    let b = Array.set a 1 2
    if fromMaybe 0 (Array.index b 1) == 2 then abandon else pure b)
  BOC.when c (\a -> do
    let b = Array.set a 2 7
    BOC.when givenOut (\x -> pure (fromMaybe 0 (Array.index b 2)))
    if fromMaybe 0 (Array.index b 2) == 7 then abandon else pure b)
  with a := c do
    let m = Array.set a 2 3
    BOC.when madeOut (\x -> pure m)
  with a := c do
    let r = fromMaybe 0 (Array.index (Array.set a 3 9) 3)
    BOC.when readAt (\x -> pure r)
  BOC.when c (\a -> do
    let b = Array.set a 3 4
    BOC.when
        d
        (\x ->
           pure (fromMaybe 0 (Array.index b 0) + fromMaybe 0 (Array.index b 3)))
    pure b)
  BOC.when s (\a -> pure (Array.set a 1 "b"))
  BOC.when s (\a -> do
    let b = Array.set a 0 "x"
    if fromMaybe "" (Array.index b 0) == "x" then abandon else pure b)
  pure (c, s, givenOut, madeOut, readAt, d)

-- | a pair of an array of three 0s and 0 in a cown, its array written
-- | in place where nothing else sees it: 1 at 0, written; 2 at 1, by a
-- | body that then fails; 5 at 2, by a body that then reads the pair it
-- | was given, adding what its array holds at 2 -- 0, the array as it
-- | was -- to the count, where to read made of what it wrote, so read
-- | after it; 7 at 2, by a body that gives the array to a
-- | behaviour on another cown, which puts what it holds at 2 there,
-- | and then fails.  The pair then holds 1 0 5 and 0; the other, 7
pairs : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> Co e (BOC.Cown (Array Int, Int), BOC.Cown Int)
pairs = do
  c <- BOC.newCown (Array.replicate 3 (0 : Int), (0 : Int))
  givenOut <- BOC.newCown 0
  BOC.when c (\p -> case p of
    (a, m) -> pure (Array.set a 0 1, m))
  BOC.when c (\p -> case p of
    (a, m) -> do
      let b = Array.set a 1 2
      if fromMaybe 0 (Array.index b 1) == 2 then abandon else pure (b, m))
  BOC.when c (\p -> case p of
    (a, m) -> do
      let b = Array.set a 2 5
      -- (where it reads, 2, read of what it wrote: after it)
      let at = fromMaybe 0 (Array.index b 2) - 3
      pure (b, m + fromMaybe 0 (Array.index (fst p) at)))
  BOC.when c (\p -> case p of
    (a, m) -> do
      let b = Array.set a 2 7
      BOC.when givenOut (\x -> pure (fromMaybe 0 (Array.index b 2)))
      if fromMaybe 0 (Array.index b 2) == 7 then abandon else pure (b, m))
  pure (c, givenOut)

-- | a pair in a cown bound by a pattern, `(a, b) := c`: `b` set, so the
-- | pair written back, 1 12; read by another, beside a cown it sets to
-- | their sum, 13; then `b` doubled through `(_, b)`, the `_` given back
-- | as it was: 1 24
patterned : {e : HFunctor}
          -> {{bc : BOC.boc <: e}}
          -> Co e (BOC.Cown (Int, Int), BOC.Cown Int)
patterned = do
  c <- BOC.newCown ((1 : Int), (2 : Int))
  seen <- BOC.newCown (0 : Int)
  with (a, b) := c do
    b := b + 10
  with (a, b) := c
       s := seen do
    s := a + b
  with (_, b) := c do
    b := b * 2
  pure (c, seen)

-- | a `with` on one cown twice, spawned by a behaviour on another: a
-- | failure, said, that `with` never queued, the one spawning it going
-- | on and its write kept: 1 and 11
twiceIn : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> Co e (BOC.Cown Int, BOC.Cown Int)
twiceIn = do
  r <- BOC.newCown (1 : Int)
  s <- BOC.newCown (10 : Int)
  with b := s do
    with x := r
         y := s
         z := r do
      x := x + 100
    b := b + 1
  pure (r, s)

-- | what the program says, line by line, given to `out` by a last
-- | behaviour once every part is done: each part started by the one
-- | before it, once that one's line is put.  `cores`, how many threads
-- | run behaviours at once.  The failures of the parts' bodies are said
-- | on stderr, one a line: at 1, five abandons and the same cown twice,
-- | in that order
said : {e : HFunctor}
     -> {{bc : BOC.boc <: e}}
     -> Int
     -> (List String -> Co e Unit)
     -> Co e Unit
said cores out = do
  ls <- BOC.newCown (Nil : List String)
  chained
      [ \next -> do
          n <- counted
          line ls n (\v -> "added by 1000: " ^ debug v) next
      , \next -> do
          held <- accounts
          line
              ls
              held
              (\(p, q, r, s) ->
                 "accounts: "
                 ^ unwords (List.map debug [p, q, r, s, p + q + r + s]))
              next
      , \next -> do
          xs <- ordered
          line
              ls
              xs
              (\v ->
                 "in the order spawned: "
                 ^ (if List.reverse v == List.range 1 100 then "yes" else "no"))
              next
      , \next -> do
          ab <- nested
          lineAfter
              (fst ab)
              ls
              ab
              (\(x, y) -> "nested: " ^ debug x ^ " " ^ debug y)
              next
      , \next -> do
          failedOut <- failing
          line
              ls
              failedOut
              (\f -> "a failing behaviour: " ^ debug f ^ " added by the others")
              next
      , \next -> do
          seenOut <- kept
          -- (once the one on both has read how many have run)
          with l := ls
               seen := seenOut
               once seen >= 0 do
            next
            l :=
              ("kept in a long body's slot: "
               ^ (if seen >= 0 then "run" else "not run")
               ^ (if cores == 1 || seen < longBound
                  then ", before its end where another thread is"
                  else ", only after its end"))
              :: l
      , \next -> do
          turnsOut <- inTurn
          -- (once the fifth's turn is done)
          with l := ls
               t := turnsOut
               once fst t > 5 do
            next
            l :=
              ("waiting for their turns: "
               ^ unwords (List.map debug (List.reverse (snd t))))
              :: l
      , \next -> do
          oneOut <- waitingOnOne
          -- (once the waiting one has put what they hold)
          with l := ls
               o := oneOut
               once fst o > 0 do
            next
            l :=
              ("waiting on one of two: "
               ^ debug (fst o)
               ^ " "
               ^ debug (snd o))
              :: l
      , \next -> do
          neverOut <- neverHeld
          line
              ls
              neverOut
              (\never ->
                 "a condition never holding: "
                 ^ (if never then "its body ran" else "its body never ran"))
              next
      , \next -> do
          spreadOut <- spread
          line
              ls
              spreadOut
              (\(s0, s1, s2, s3) ->
                 "a name holding two cowns: "
                 ^ unwords (List.map debug [s0, s1, s2, s3]))
              next
      , \next -> do
          arraysOut <- arrays
          lineAfter
              (case arraysOut of
               (c, _, _, _, _, _) -> c)
              ls
              arraysOut
              (\(arr, strs, given, made, readBack, dHeld) ->
                 "an array in a cown: "
                 ^ unwords (List.map debug (numbers arr))
                 ^ ", given on by a body that failed: "
                 ^ debug given
                 ^ ", a write not kept: "
                 ^ unwords (List.map debug (numbers made))
                 ^ ", one read: "
                 ^ debug readBack
                 ^ ", given on: "
                 ^ debug dHeld
                 ^ ", strings: "
                 ^ unwords (strings strs))
              next
      , \next -> do
          pairsOut <- pairs
          lineAfter
              (fst pairsOut)
              ls
              pairsOut
              (\((pa, pm), pg) ->
                 "an array in a pair in a cown: "
                 ^ unwords (List.map debug (numbers pa))
                 ^ " and "
                 ^ debug pm
                 ^ ", given on by a body that failed: "
                 ^ debug pg)
              next
      , \next ->
        BOC.parMap
          (\i -> i * i)
          (List.range 1 6)
          (\ys ->
             BOC.parMap
               (\(i : Int) -> i)
               Nil
               (\zs ->
                  put
                    ls
                    ("parMap, in order: "
                     ^ unwords (List.map debug ys)
                     ^ ", of none: "
                     ^ debug (List.length zs))
                    next))
      , \next -> do
          cs <- patterned
          line
              ls
              cs
              (\((a, b), s) ->
                 "a pattern bound: "
                 ^ debug a
                 ^ " "
                 ^ debug b
                 ^ ", read "
                 ^ debug s)
              next
      , \next -> do
          rs <- twiceIn
          line
              ls
              rs
              (\(r, s) -> "the same cown twice: " ^ debug r ^ " " ^ debug s)
              next
      , \next -> do
          w <- BOC.workers
          put
              ls
              ("workers, as many as the threads: "
               ^ (if w == cores then "yes" else debug w))
              next
      ]
      (BOC.when ls (\l -> do
       out (List.reverse l)
       pure l))
