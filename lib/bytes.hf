-- `Bytes`: bytes, not changed once made -- a body, what a socket reads,
-- a file's content where it is no text -- a type of its own beside
-- `String`, which is text (though any bytes may be in one).  A byte is a
-- `UInt8`.  A C program keeps them as a buffer of bytes, a JavaScript
-- one as a `Uint8Array`.  Import it by a name, `import bytes as Bytes`,
-- as its names are the prelude's lists' too: `Bytes.length`,
-- `Bytes.fromString`.  A binary writes them, `b["hi", 255]`, and takes
-- them apart; their equality,
-- `instanceEqualityBytes`, is the prelude's, as `==` is, and so are
-- their `Debug`, `instanceDebugBytes`, which writes them as a binary does,
-- and their `Show`, `instanceShowBytes`, which reads them as
-- UTF-8 text.

module bytes
  ( bytesAt
  , bytesAppend
  , bytesFromList
  , bytesFromString
  , bytesAsString
  , length
  , toList
  , fromList
  , empty
  , fromString
  , asString
  , index
  , slice
  , append
  , concat
  , indexOf
  , split
  , foldl
  , map
  , eq
  )

import uint8 as UInt8

primitive bytesAt : Bytes -> Int -> UInt8
primitive bytesAppend : Bytes -> Bytes -> Bytes
primitive bytesFromList : List UInt8 -> Bytes
primitive bytesFromString : String -> Bytes
primitive bytesAsString : Bytes -> String
primitive bytesFind : Bytes -> Bytes -> Int -> Int

-- Read
--------------------------------------------------------------------------------

-- | How many.
length : Bytes -> Int
length = bytesLength

toList : Bytes -> List UInt8
toList = bytesToList

-- Made
--------------------------------------------------------------------------------

-- | >>> toList (fromList [104, 105, 255])
-- | [104, 105, 255]
fromList : List UInt8 -> Bytes
fromList = bytesFromList

-- | None.
-- | >>> length empty
-- | 0
empty : Bytes
empty = bytesFromList Nil

-- | A string's bytes, as they are: UTF-8, as a literal writes it.
-- | >>> toList (fromString "hé")
-- | [104, 195, 169]
-- | >>> length (fromString "hé")
-- | 3
fromString : String -> Bytes
fromString = bytesFromString

-- | The bytes as a string, as they are, UTF-8 or not: `fromString`
-- | undone.  (`show` reads them as text, what is not UTF-8 U+FFFD.)
-- | >>> asString (fromList [104, 105, 255]) == "hi\xff"
-- | True
asString : Bytes -> String
asString = bytesAsString

-- Taken apart and put together
--------------------------------------------------------------------------------

-- | The byte at `i`, if there is one: out of range, `Nothing`.
-- | >>> List.map (index (fromString "hi")) [1, 2, -1]
-- | [Just 105, Nothing, Nothing]
index : Bytes -> Int -> Maybe UInt8
index b i = if 0 <= i && i < bytesLength b then Just (bytesAt b i) else Nothing

-- | The bytes from `i` up to `j`, `j` not among them, each where it is
-- | clamped to them, and a negative one counted from the end, as a
-- | string's slice is (`strSlice`, JavaScript's `slice`).
-- | >>> List.map show [slice (fromString "hello") 1 3, slice (fromString "hello") 3 9, slice (fromString "hello") -2 5]
-- | ["el", "lo", "lo"]
slice : Bytes -> Int -> Int -> Bytes
slice = bytesSlice

-- | The bytes of `a`, then those of `b`.
-- | >>> show (append (fromString "he") (fromString "ff"))
-- | "heff"
append : Bytes -> Bytes -> Bytes
append = bytesAppend

-- | Each one's bytes, one after another, made at once: each copied once,
-- | however many there are.
-- | >>> toList (concat [fromList [1], empty, fromList [2, 3]])
-- | [1, 2, 3]
concat : List Bytes -> Bytes
concat = bytesConcat

-- Searched
--------------------------------------------------------------------------------

-- | Where the bytes `needle` are first in `b`, from byte `from` on (from
-- | 0, a `from` below it), if they are: as a string's `indexOf`, by
-- | the runtime, not a byte at a time.
-- | >>> List.map (indexOf b["lo"] b["hello, world: lo"]) [0, 4, 15, 99, -5]
-- | [Just 3, Just 14, Nothing, Nothing, Just 3]
-- | >>> List.map (indexOf b["he"] b["hello"]) [0, 1]
-- | [Just 0, Nothing]
-- | >>> indexOf b["x"] b["hello"] 0
-- | Nothing
-- | >>> List.map (indexOf b["aa"] b["aaa"]) [0, 1, 2]
-- | [Just 0, Just 1, Nothing]
-- | >>> List.map (indexOf b[] b["ab"]) [-1, 2, 3]
-- | [Just 0, Just 2, Nothing]
-- | >>> indexOf b["\r\n"] b[255, 0, "\r\n"] (from := 1)
-- | Just 2
indexOf : Bytes -> Bytes -> (from : Int) -> Maybe Int
indexOf needle b from = foundAt (bytesFind needle b from)
  where
  -- (an index found, if it is one: -1 is none)
  foundAt : Int -> Maybe Int
  foundAt j = if j < 0 then Nothing else Just j

-- | The pieces of `b` between the `sep`s, as a string's `split`: one
-- | where there is none, an empty one where two are side by side or
-- | `b` begins or ends with one, and `b` whole where `sep` is empty.
-- | Each piece is a `slice` of `b`.
-- | >>> List.map show (split b["--"] b["a--b----c"])
-- | ["a", "b", "", "c"]
-- | >>> List.map show (split b["\r\n"] b["\r\nhead\r\n"])
-- | ["", "head", ""]
-- | >>> List.map show (split b[","] b["abc"])
-- | ["abc"]
-- | >>> List.map show (split b["aa"] b["aaa"])
-- | ["", "a"]
-- | >>> List.map show (split b[] b["ab"])
-- | ["ab"]
-- | >>> List.map show (split b[","] empty)
-- | [""]
split : Bytes -> Bytes -> List Bytes
split sep b =
  if bytesLength sep == 0 then [b] else splitFrom 0 (bytesFind sep b 0) Nil
  where
  backwards : List Bytes -> List Bytes -> List Bytes
  backwards [] out = out
  backwards (x :: xs) out = backwards xs (x :: out)

  -- (the pieces of `b` from `i` on, the next `sep` at `j` (-1: none),
  -- into `acc`, last first)
  splitFrom : Int -> Int -> List Bytes -> List Bytes
  splitFrom i j acc =
    if j < 0 then backwards (bytesSlice b i (bytesLength b) :: acc) Nil
    else splitFrom
        (j + bytesLength sep)
        (bytesFind sep b (j + bytesLength sep))
        (bytesSlice b i j :: acc)

-- Gone through
--------------------------------------------------------------------------------

-- | Each byte, from the first, into `z`, as `List.foldl` goes.
-- | >>> foldl (\n b -> n * 256 + UInt8.toInt b) 0 (fromList [1, 2, 3])
-- | 66051
foldl : {a : Type} -> (a -> UInt8 -> a) -> a -> Bytes -> a
foldl f z b = from 0 z
  where
  -- (the bytes from `i` on, into `acc`)
  from : Int -> a -> a
  from i acc =
    if i >= bytesLength b then acc else from (i + 1) (f acc (bytesAt b i))

-- | Each byte `f` of it: as many bytes.
-- | >>> toList (map (\x -> x + 1) (fromList [1, 2, 255]))
-- | [2, 3, 0]
map : (UInt8 -> UInt8) -> Bytes -> Bytes
map f b =
  bytesFromString
    (mapBytes (\c -> UInt8.toInt (f (UInt8.fromInt c))) (bytesAsString b))

-- Compared
--------------------------------------------------------------------------------

-- | Whether they are the same bytes, as `==` says (the prelude's
-- | `instanceEqualityBytes`).
-- | >>> eq (fromString "hi") (fromList [104, 105])
-- | True
eq : Bytes -> Bytes -> Bool
eq = bytesEq
