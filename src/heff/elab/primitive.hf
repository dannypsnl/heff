  , FloatShow
  , FloatFromInt
  , FloatSqrt
  , OnWindows
  , FloatFloor
  , FloatSin
  , FloatCos
  , FloatTan
  , FloatAsin
  , FloatAcos
  , FloatAtan
  , FloatAtan2
  , FloatExp
  , FloatLog
  , FloatPow
  , ArrayLength
  , ArrayIndex
  , ArraySet
  , ArrayGenerate
  , ArrayFromList
  , ArrayToList
  , ArrayReplicate
  , ArraySlice
  , ArrayAppend
  , ArrayInsertAt
  , ArrayRemoveAt
  , ArrayPush
  , ArrayReserve
  , Hole
  , SetField
  , StrAppend
  , StrLength
  , StrSlice
  , StrEq
  , StrLt
  , StrCompare
  , StrFind
  , RuneEq
  , RuneLt
  , RuneLe
  , RuneToInt
  , RuneFromInt
  , Keep
  , Panic
  ]

-- | a string's as bytes, `Bytes`', `Bits`', the hashes
textPrims : List Prim
textPrims =
  [ StrByteAt
  , StrFromByte
  , StrRuneAt
  , StrRuneWidth
  , StrRuneCount
  , StrRunes
  , StrOfRunes
  , StrToJS
  , StrFromJS
  , BytesLength
  , BytesAt
  , BytesSlice
  , BytesAppend
  , BytesConcat
  , BytesEq
  , BytesFromList
  , BytesToList
  , BytesFromString
  , BytesAsString
  , BytesToString
  , BytesIntAt
  , BytesOfInt
  , BytesHasAt
  , BytesFind
  , BitsLength
  , BitsIntAt
  , BitsOfInt
  , BitsConcat
  , BitsSlice
  , BitsOfBytes
  , BitsBytes
  , BitsEq
  , FloatBits
  , FloatOfBits
  , FloatOfDecimal
  , StrHash
  , StrHashRange
  , StrEqRange
  , IntHash
  , TrieSlot
  ]

-- | those the library may declare (`primitive`), in order
-- | >>> List.length libraryPrims
-- | 245
libraryPrims : List Prim
libraryPrims =
  List.append
    basicPrims
    (List.append
       textPrims
       (List.map (\(p : FixedPrim) -> OfFixed p.fixed p.op) fixedPrims))

-- | the compiler's own
compilerPrims : List Prim
compilerPrims =
  [ Perform
  , WordAdd
  , WordSub
  , WordMul
  , WordDiv
  , WordMod
  , WordQuot
  , WordRem
  , WordEq
  , WordLt
  , WordLe
  , WordToFloat
  , ArrayIndexIn
  , ArrayIndexInAny
  , ArrayPeek
  , ArrayPeekIn
  , ArraySetOwned
  , ArraySetOwnedIn
  , ArrayOwn
  , ArrayKeeps
  , ArrayKeepsAs
  , Reuse
  , SetFieldPeek
  , StrRuneDecode
  , FuelTick
  , FuelTicks
  , CustodianDue
  , CustodyIn
  , BocWhen
  , BocNew
  , BocTaken
  , BocGiven
  ]

-- (each of them by its name)
byName : List Prim -> OrdMap.OrdMap String Prim
byName ps = OrdMap.fromList (List.map (\p -> MkPair (primName p) p) ps)

libraryTable : OrdMap.OrdMap String Prim
libraryTable = byName libraryPrims

compilerTable : OrdMap.OrdMap String Prim
compilerTable = byName compilerPrims

-- | the one the library declares by that name
-- | >>> maybe "" primName (libraryPrimOf "uint16Shr")
-- | "uint16Shr"
-- | >>> maybe "" primName (libraryPrimOf "arrayPeek")
-- | ""
libraryPrimOf : String -> Maybe Prim
libraryPrimOf x = OrdMap.lookup libraryTable x

-- (the leaf of a `performAt` name)
performAtOf : String -> Maybe Int
performAtOf x =
  if startsWith "performAt" x then parseInt (strSlice x 9 (strLength x))
  else Nothing

-- | the one of that name, any (as a cache has it)
-- | >>> List.all (\p -> maybe False (\q -> strEq (primName q) (primName p)) (primOfName (primName p))) (List.append libraryPrims compilerPrims)
-- | True
-- | >>> maybe "" primName (primOfName "performAt3")
-- | "performAt3"
primOfName : String -> Maybe Prim
primOfName x =
  maybe
    (maybe
       (OrdMap.lookup compilerTable x)
       (\i -> Just (PerformAt i))
       (performAtOf x))
    Just
    (OrdMap.lookup libraryTable x)
