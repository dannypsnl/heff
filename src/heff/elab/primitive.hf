-- The primitives: what the runtime does itself.  The library declares
-- each one it names (`primitive intAdd : Int -> Int -> Int`), by the
-- name `primName` gives it (`libraryPrimOf`); the compiler writes the
-- others, which no program names.  A primitive is one of these from
-- where it is declared on: its name is looked at only where it is
-- written out, or read back (`primOfName`).

module heff.elab.primitive

import heff.elab.fixed
import std.ordmap as OrdMap

data Prim
  -- `Int`'s
  = IntAdd
  | IntSub
  | IntMul
  | IntDiv
  | IntMod
  | IntEq
  | IntLt
  | IntLe
  | IntShow
  | IntAnd
  | IntOr
  | IntXor
  | IntShl
  | IntShr
  -- `Float64`'s
  | FloatAdd
  | FloatSub
  | FloatMul
  | FloatDiv
  | FloatEq
  | FloatLt
  | FloatLe
  | FloatShow
  | FloatFromInt
  | FloatSqrt
  | OnWindows
  | FloatFloor
  | FloatSin
  | FloatCos
  | FloatTan
  | FloatAsin
  | FloatAcos
  | FloatAtan
  | FloatAtan2
  | FloatExp
  | FloatLog
  | FloatPow
  -- `Array`'s
  | ArrayLength
  | ArrayIndex
  | ArraySet
  | ArrayGenerate
  | ArrayFromList
  | ArrayToList
  | ArrayReplicate
  | ArraySlice
  | ArrayAppend
  | ArrayInsertAt
  | ArrayRemoveAt
  | ArrayPush
  | ArrayReserve
  -- a cell made, and one of its fields set (`run do`'s)
  | Hole
  | SetField
  -- `String`'s
  | StrAppend
  | StrLength
  | StrSlice
  | StrEq
  | StrLt
  | StrCompare
  | StrFind
  -- `Rune`'s
  | RuneEq
  | RuneLt
  | RuneLe
  | RuneToInt
  | RuneFromInt
  | Keep
  -- a failure, said: `panic`'s
  | Panic
  -- a string as bytes, UTF-8
  | StrByteAt
  | StrFromByte
  | StrRuneAt
  | StrRuneWidth
  | StrRuneCount
  | StrRunes
  | StrOfRunes
  | StrToJS
  | StrFromJS
  -- `Bytes`'
  | BytesLength
  | BytesAt
  | BytesSlice
  | BytesAppend
  | BytesConcat
  | BytesEq
  | BytesFromList
  | BytesToList
  | BytesFromString
  | BytesAsString
  | BytesToString
  | BytesIntAt
  | BytesOfInt
  | BytesHasAt
  | BytesFind
  -- `Bits`'
  | BitsLength
  | BitsIntAt
  | BitsOfInt
  | BitsConcat
  | BitsSlice
  | BitsOfBytes
  | BitsBytes
  | BitsEq
  | FloatBits
  | FloatOfBits
  | FloatOfDecimal
  -- the hashes, std.hashmap's
  | StrHash
  | StrHashRange
  | StrEqRange
  | IntHash
  | TrieSlot
  -- | a fixed-width type's (`int32Add`)
  | OfFixed Fixed FixedOp
  -- The compiler's own, which no program names: an operation of a
  -- program's world handed to the world
  | Perform
  -- | ... handed to the world's `i`th leaf's provider, where the world's
  -- | sum is known: its tags taken apart before (heff.compile.lower)
  | PerformAt Int
  -- | boc's behaviour spawned, cown made, and what a body takes and
  -- | gives, where the program does it at once, its operation not built
  -- | (heff.compile.direct)
  | BocWhen
  | BocNew
  | BocTaken
  | BocGiven
  -- | an `Int` known to be a word (heff.compile.ranges), the operation
  -- | of the `Int` primitive done on words
  | WordAdd
  | WordSub
  | WordMul
  | WordDiv
  | WordMod
  | WordQuot
  | WordRem
  | WordEq
  | WordLt
  | WordLe
  | WordToFloat
  -- | an array's, as C has them: read in range (`ArrayIndexIn`), of a
  -- | fixed-width number however kept (`ArrayIndexInAny`); looked at,
  -- | not taken (`ArrayPeek`, in range `ArrayPeekIn`); set in place
  -- | (`ArraySetOwned`, in range `ArraySetOwnedIn`); made its own
  -- | (`ArrayOwn`); whether it keeps its elements flat (`ArrayKeeps`),
  -- | as an element would be (`ArrayKeepsAs`)
  | ArrayIndexIn
  | ArrayIndexInAny
  | ArrayPeek
  | ArrayPeekIn
  | ArraySetOwned
  | ArraySetOwnedIn
  | ArrayOwn
  | ArrayKeeps
  | ArrayKeepsAs
  -- | a tag built in a cell kept for it, while it is made
  -- | (heff.compile.refcount)
  | Reuse
  -- | a field of a cell lent set, the cell not given up, and the value
  -- | set given back lent: held by the cell (heff.compile.refcount)
  | SetFieldPeek
  -- | a string's rune at a byte and how many bytes it takes, read once:
  -- | `strRuneAt`'s and `strRuneWidth`'s of the same operands, a tuple
  -- | of the two (heff.compile.runes)
  | StrRuneDecode
  -- | a tick of fuel, at a function's entry: the fuel counted down, the
  -- | computation stopped where it runs out (heff.compile.fuel)
  | FuelTick
  -- | ... of a batch of a loop's rounds: so many ticks at once
  | FuelTicks
  -- | the releases due on the thread run, those of `with`s a throw left,
  -- | before an operation is performed, where the program's world has
  -- | the custodian's effect (heff.compile.lower's entry)
  | CustodianDue
  -- | the custodian current where an operation is performed, told the
  -- | runtime just before it: the entry's, where the program's world has
  -- | the custodian's effect (heff.compile.lower's entry)
  | CustodyIn

-- | its name: the library's, the runtime's (`heff_intAdd`), a cache's
-- | >>> List.map primName [IntAdd, OfFixed U16 OpShr, ArrayIndexInAny]
-- | Cons "intAdd" (Cons "uint16Shr" (Cons "arrayIndexInAny" Nil))
