-- An untyped evaluator for elaborated syntax.  Types evaluate to
-- `VErased`.
--
-- Evaluation is by value, as the compiled code runs: an argument, a
-- constructor's field and a record's field are evaluated before they
-- are passed or put, in order, used or not.  A global is evaluated when
-- first used.  `abandon` is a value, `Abn`, threaded through every
-- step -- so a watch that abandons reports `<abandoned>` instead of
-- ending the run.  Evaluation that nests deeper than `deepest`, or
-- whose path takes more than `longest` steps, is said to diverge, `Div`:
-- every function and every thunk is given the depth it is forced at, and
-- a step in a tail position -- a function's body, applied, a match's arm
-- -- nests no deeper, so a loop's depth stays put while its steps count
-- to `longest`, as a recursion's nesting counts to `deepest`.  What
-- type checking rules out -- a value of the wrong
-- shape, a name not in scope -- is a bug of the compiler, `Bug`, said
-- (`<compiler bug: ...>`) and never taken for a value.

module heff.compile.interp

import array as Array
import float32 as Float32
import heff.util.dict as Dict
import heff.elab.fixed as Fixed
import heff.elab.globals as Globals
import heff.elab.primitive
import heff.elab.rename as Rename
import heff.util.rune as RuneUtil
import heff.elab.syntax as Syntax
import std.ordmap as OrdMap
import rune as Rune
import std.math as Math
import uint8 as UInt8

-- | a computation forced at a depth
type Th a = Int -> a

data Res a = Ok a | Abn | Div | Bug String

data Val
  = VFun (Int -> Th (Res Val) -> Res Val)
  | VCons (Dict.Dict Val)
  | VTag String (List Val)
  | VInt Int
  | VFloat Float64
  | VFloat32 Float32
  | VStr String
  -- | a `Rune`: its code point
  | VRune Int
  | VArr (Array Val)
  -- | `Bytes`: kept as a string of them
  | VBytes String
  -- | `Bits`: how many, and the bytes they are in, the most significant
  -- | bit of the first first, those past them 0
  | VBits Int String
  | VErased

type RVal = Res Val

rbind : RVal -> (Val -> RVal) -> RVal
rbind (Ok v) f = f v
rbind Abn f = Abn
rbind Div f = Div
rbind (Bug what) f = Bug what

okTh : Val -> Th RVal
okTh v = \d -> Ok v

-- | how deep evaluation nests -- how many evaluations wait, one inside
-- | another, for its value -- before it is said to diverge: deeper than a
-- | program that ends needs, and within the interpreter's own stack
deepest : Int
deepest = 1000000

-- | how many steps the path to a computation takes, tail ones too,
-- | before it is said to diverge: the end of a loop that never ends
longest : Int
longest = 100000000

-- (a depth is one `Int`, so that passing it allocates nothing: how deep
-- it nests in the bits from 40 up, how many steps its path took below
-- them)
nestUnit : Int
nestUnit = 1099511627776

-- (the depth where the nesting is past `deepest`)
nestedTooDeep : Int
nestedTooDeep = (deepest + 1) * nestUnit

-- (a computation at depth `d` waited for, nested in it: one deeper, and a
-- step)
nested : Int -> Int
nested d = d + nestUnit + 1

-- (a step on from depth `d`, in a tail position: no deeper)
onward : Int -> Int
onward d = d + 1

-- (whether evaluation at depth `d` is said to diverge)
diverges : Int -> Bool
diverges d = d >= nestedTooDeep || d % nestUnit > longest

-- | a function applied, by evaluation at depth `d`
app : Int -> Val -> Th RVal -> RVal
app d (VFun f) v = f d v
app d VErased _ = Ok VErased
app d _ _ = Bug "applied what is not a function"

projV : Val -> String -> RVal
projV (VCons fs) x = Ok (Dict.elemAt fs x)
projV VErased _ = Ok VErased
projV _ x = Bug ("`." ^ x ^ "` of what is not a record")

-- Primitives (the interpreter's side of `heff.compile.prims`): answers are
-- builtin's Bool, the tags True/False
--------------------------------------------------------------------------------

boolV : Bool -> Val
boolV b = VTag (if b then "True" else "False") Nil

-- (a primitive given a value of the wrong shape, a bug of the compiler:
-- each said once, not at every primitive that takes such a value)
notAnInt : RVal
notAnInt = Bug "a primitive given what is not an `Int`"

notAFloat64 : RVal
notAFloat64 = Bug "a primitive given what is not a `Float64`"

notAString : RVal
notAString = Bug "a primitive given what is not a `String`"

notARune : RVal
notARune = Bug "a primitive given what is not a `Rune`"

notAnArray : RVal
notAnArray = Bug "a primitive given what is not an array"

notBytes : RVal
notBytes = Bug "a primitive given what is not `Bytes`"

notAFloat32 : RVal
notAFloat32 = Bug "a primitive given what is not a `Float32`"

intTake2 : (Int -> Int -> RVal) -> Val -> Val -> RVal
intTake2 f (VInt a) (VInt b) = f a b
intTake2 f _ _ = notAnInt

int2 : (Int -> Int -> RVal) -> Val
int2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> intTake2 f av bv)))))

floatTake1 : (Float64 -> RVal) -> Val -> RVal
floatTake1 f (VFloat a) = f a
floatTake1 f _ = notAFloat64

float1 : (Float64 -> RVal) -> Val
float1 f = VFun (\d a -> rbind (a d) (\av -> floatTake1 f av))

floatTake2 : (Float64 -> Float64 -> RVal) -> Val -> Val -> RVal
floatTake2 f (VFloat a) (VFloat b) = f a b
floatTake2 f _ _ = notAFloat64

float2 : (Float64 -> Float64 -> RVal) -> Val
float2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> floatTake2 f av bv)))))

strTake1 : (String -> RVal) -> Val -> RVal
strTake1 f (VStr a) = f a
strTake1 f _ = notAString

str1 : (String -> RVal) -> Val
str1 f = VFun (\d a -> rbind (a d) (\av -> strTake1 f av))

strTake2 : (String -> String -> RVal) -> Val -> Val -> RVal
strTake2 f (VStr a) (VStr b) = f a b
strTake2 f _ _ = notAString

str2 : (String -> String -> RVal) -> Val
str2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> strTake2 f av bv)))))

runeTake1 : (Int -> RVal) -> Val -> RVal
runeTake1 f (VRune a) = f a
runeTake1 f _ = notARune

rune1 : (Int -> RVal) -> Val
rune1 f = VFun (\d a -> rbind (a d) (\av -> runeTake1 f av))

runeTake2 : (Int -> Int -> RVal) -> Val -> Val -> RVal
runeTake2 f (VRune a) (VRune b) = f a b
runeTake2 f _ _ = notARune

rune2 : (Int -> Int -> RVal) -> Val
rune2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> runeTake2 f av bv)))))

bytesTake1 : (String -> RVal) -> Val -> RVal
bytesTake1 f (VBytes a) = f a
bytesTake1 f _ = notBytes

bytes1 : (String -> RVal) -> Val
bytes1 f = VFun (\d a -> rbind (a d) (\av -> bytesTake1 f av))

bytesTake2 : (String -> String -> RVal) -> Val -> Val -> RVal
bytesTake2 f (VBytes a) (VBytes b) = f a b
bytesTake2 f _ _ = notBytes

bytes2 : (String -> String -> RVal) -> Val
bytes2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> bytesTake2 f av bv)))))

bitsTake1 : (Int -> String -> RVal) -> Val -> RVal
bitsTake1 f (VBits n a) = f n a
bitsTake1 f _ = Bug "a primitive given what is not `Bits`"

bits1 : (Int -> String -> RVal) -> Val
bits1 f = VFun (\d a -> rbind (a d) (\av -> bitsTake1 f av))

-- (a list's bytes, each a `UInt8`, as a string of them; what is no byte,
-- none)
byteString : List Val -> String -> String
byteString [] acc = acc
byteString (VInt c :: rest) acc =
  byteString rest (acc ^ fromByte (UInt8.fromInt c))
byteString (_ :: rest) acc = byteString rest acc

-- (a list's `Bytes`, one after another; what is no `Bytes`, a bug)
bytesJoined : List Val -> String -> RVal
bytesJoined [] acc = Ok (VBytes acc)
bytesJoined (VBytes b :: rest) acc = bytesJoined rest (acc ^ b)
bytesJoined (_ :: rest) acc = notBytes

-- (a binary's segments', as the runtime's `heff_bytesIntAt` and
-- `heff_bytesOfInt`: 2 to the `k`)
twoTo : Int -> Int
twoTo k = if k <= 0 then 1 else 2 * twoTo (k - 1)

-- (the `n` bits of `s` from bit `i`, the most significant first, after
-- `acc`)
bitsRead : String -> Int -> Int -> Int -> Int
bitsRead s i n acc =
  if n <= 0 then acc
  else bitsRead
      s
      (i + 1)
      (n - 1)
      (acc * 2 + byteAt s (i / 8) / twoTo (7 - i % 8) % 2)

-- (`u`, of `n` bits, as a signed integer where `signed` is)
signedOf : Bool -> Int -> Int -> Int
signedOf signed n u =
  if signed && n > 0 && u >= twoTo (n - 1) then u - twoTo n else u

-- (an integer of `n` bits, little-endian, as Erlang's: its bytes the
-- least significant first, then the `n % 8` bits left, the most
-- significant -- the bits as written, of `u`)
littleOutGo : Int -> Int -> Int -> Int -> Int
littleOutGo u k i w =
  if i >= k then w
  else littleOutGo u k (i + 1) (w * 256 + u / twoTo (8 * i) % 256)

littleOut : Int -> Int -> Int
littleOut u n =
  littleOutGo u (n / 8) 0 0 * twoTo (n % 8)
  + u / twoTo (8 * (n / 8)) % twoTo (n % 8)

-- (and the integer, of the bits as written, `w`)
littleInGo : Int -> Int -> Int -> Int -> Int -> Int
littleInGo w n k i acc =
  if i >= k then acc
  else littleInGo
      w
      n
      k
      (i + 1)
      (acc + w / twoTo (n - 8 * (i + 1)) % 256 * twoTo (8 * i))

littleIn : Int -> Int -> Int
littleIn w n =
  littleInGo w n (n / 8) 0 (w % twoTo (n % 8) * twoTo (8 * (n / 8)))

-- (the integer of `n` bits at bit `o` of `s`, of `limit` bits, the
-- flags `f` 1 for little-endian, 2 for signed; out of them, abandoned)
intAtV : String -> Int -> Int -> Int -> Int -> RVal
intAtV s limit o n f =
  if o < 0 || n < 0 || n > 64 || o + n > limit then Abn
  else if f % 2 == 1
  then Ok (VInt (signedOf (f / 2 % 2 == 1) n (littleIn (bitsRead s o n 0) n)))
  else Ok (VInt (signedOf (f / 2 % 2 == 1) n (bitsRead s o n 0)))

bytesIntAtV : String -> Int -> Int -> Int -> RVal
bytesIntAtV s o n f = intAtV s (strLength s * 8) o n f

-- (the `k` bytes of `u`, not negative, the most significant first,
-- after `acc`)
bytesOfNat : Int -> Int -> String -> String
bytesOfNat k u acc =
  if k <= 0 then acc
  else bytesOfNat (k - 1) (u / 256) (fromByte (UInt8.fromInt (u % 256)) ^ acc)

-- (the `n` bits of `w`, the most significant first, as bytes, those
-- past them 0)
bitsOfWord : Int -> Int -> String
bitsOfWord n w = bytesOfNat ((n + 7) / 8) (w * twoTo ((n + 7) / 8 * 8 - n)) ""

-- (the integer `v`'s low `n` bits as written: little-endian where the
-- flags `f` have 1)
wordOf : Int -> Int -> Int -> Int
wordOf n f v =
  if f % 2 == 1 then littleOut ((v % twoTo n + twoTo n) % twoTo n) n
  else (v % twoTo n + twoTo n) % twoTo n

-- (the integer `v`, its low `n` bits, a multiple of 8, as bytes)
bytesOfIntV : Int -> Int -> Int -> RVal
bytesOfIntV n f v =
  if n < 0 || n > 64 || not (n % 8 == 0) then Abn
  else Ok (VBytes (bitsOfWord n (wordOf n f v)))

-- (as bits, of 0 to 64)
bitsOfIntV : Int -> Int -> Int -> RVal
bitsOfIntV n f v =
  if n < 0 || n > 64 then Abn else Ok (VBits n (bitsOfWord n (wordOf n f v)))

-- (`s`, a byte replaced by `b`: its last)
lastByteSet : String -> Int -> String
lastByteSet s b = strSlice s 0 (strLength s - 1) ^ fromByte (UInt8.fromInt b)

-- (the bits `s`, `n` of them, and then the `k` bits of `w`, 0 to 8)
bitsPush : Int -> String -> Int -> Int -> String
bitsPush n s w k =
  if k <= 0 then s
  else if n % 8 == 0 then s ^ fromByte (UInt8.fromInt (w * twoTo (8 - k)))
  else if k <= 8 - n % 8
  then lastByteSet
      s
      (byteAt s (strLength s - 1) + w * twoTo (8 - n % 8 - k))
  else bitsPush
      (n + 8 - n % 8)
      (lastByteSet
         s
         (byteAt s (strLength s - 1) + w / twoTo (k - (8 - n % 8))))
      (w % twoTo (k - (8 - n % 8)))
      (k - (8 - n % 8))

-- (the bits `s`, `n` of them, and then those of `t` from bit `i` up
-- to `j`)
bitsCopy : Int -> String -> String -> Int -> Int -> String
bitsCopy n s t i j =
  if i >= j then s
  else if n % 8 == 0 && i % 8 == 0 && j - i >= 8
  then bitsCopy
      (n + (j - i) / 8 * 8)
      (s ^ strSlice t (i / 8) (i / 8 + (j - i) / 8))
      t
      (i + (j - i) / 8 * 8)
      j
  else bitsCopy
      (n + min 8 (j - i))
      (bitsPush n s (bitsRead t i (min 8 (j - i)) 0) (min 8 (j - i)))
      t
      (i + min 8 (j - i))
      j

-- (the `n` bits from bit `o` of the `m` kept in `s`; out of them,
-- abandoned)
bitsSliceV : Int -> String -> Int -> Int -> RVal
bitsSliceV m s o n =
  if o < 0 || n < 0 || o + n > m then Abn
  else Ok (VBits n (bitsCopy 0 "" s o (o + n)))

-- (a list's `Bits`, one after another; what is no `Bits`, a bug)
bitsJoined : List Val -> Int -> String -> RVal
bitsJoined [] n acc = Ok (VBits n acc)
bitsJoined (VBits m t :: rest) n acc =
  bitsJoined rest (n + m) (bitsCopy n acc t 0 m)
bitsJoined (_ :: rest) n acc = Bug "a primitive given what is not `Bits`"

-- (2 to the `k`, a `Float64`: exact, `k` from -1022 to 1023)
twoToF : Int -> Float64
twoToF k =
  if k == 0 then 1.0
  else if k > 0 then 2.0 * twoToF (k - 1)
  else 0.5 * twoToF (k + 1)

-- (`x` times 2 to the `k`, in steps that keep it exact where what it is
-- is a float)
scaledF : Float64 -> Int -> Float64
scaledF x k =
  if k < 0 - 1000 then scaledF (x * twoToF (0 - 1000)) (k + 1000)
  else if k > 1000 then scaledF (x * twoToF 1000) (k - 1000)
  else x * twoToF k

-- (`a`, positive and finite, as a number from 1 up to 2 times 2 to the
-- `e`: `e`)
binaryExponent : Float64 -> Int -> Int
binaryExponent a e =
  if a >= 2.0 then binaryExponent (a * 0.5) (e + 1)
  else if a < 1.0 then binaryExponent (a * 2.0) (e - 1)
  else e

-- (a float not negative, IEEE's bits of it, of an exponent of `eb` bits
-- and a fraction of `fb`)
ieeeMagnitude : Int -> Int -> Float64 -> Int
ieeeMagnitude eb fb a =
  if a == 0.0 then 0
  else if not (a - a == 0.0) then (twoTo eb - 1) * twoTo fb
  else if binaryExponent a 0 >= 2 - twoTo (eb - 1)
  then (binaryExponent a 0 + twoTo (eb - 1) - 1) * twoTo fb
    + floor (scaledF a (fb - binaryExponent a 0))
    - twoTo fb
  else floor (scaledF a (twoTo (eb - 1) - 2 + fb))

-- | a float's IEEE bits, as the runtime's `heff_floatBits` has them
-- | (`x` one of the format already): a NaN the quiet one, its sign 0
ieeeBits : Int -> Int -> Float64 -> Int
ieeeBits eb fb x =
  if not (x == x) then (twoTo eb - 1) * twoTo fb + twoTo (fb - 1)
  else if x < 0.0 || (x == 0.0 && 1.0 /. x < 0.0)
  then twoTo (eb + fb) + ieeeMagnitude eb fb (0.0 - x)
  else ieeeMagnitude eb fb x

-- (of a biased exponent `e` and a fraction `m`)
ieeeMagnitudeOf : Int -> Int -> Int -> Int -> Float64
ieeeMagnitudeOf eb fb e m =
  if e == twoTo eb - 1 then (if m == 0 then 1.0 /. 0.0 else 0.0 /. 0.0)
  else if e == 0 then scaledF (toFloat m) (2 - twoTo (eb - 1) - fb)
  else scaledF (toFloat (m + twoTo fb)) (e - twoTo (eb - 1) + 1 - fb)

-- | the float whose IEEE bits are `u`
ieeeOf : Int -> Int -> Int -> Float64
ieeeOf eb fb u =
  if u / twoTo (eb + fb) % 2 == 1
  then (0.0 - 1.0)
    * ieeeMagnitudeOf eb fb (u / twoTo fb % twoTo eb) (u % twoTo fb)
  else ieeeMagnitudeOf eb fb (u / twoTo fb % twoTo eb) (u % twoTo fb)

floatBitsV : Int -> Float64 -> RVal
floatBitsV 64 x = Ok (VInt (ieeeBits 11 52 x))
floatBitsV 32 x =
  Ok (VInt (ieeeBits 8 23 (Float32.toFloat (Float32.fromFloat x))))
floatBitsV n x = Abn

floatOfBitsV : Int -> Int -> RVal
floatOfBitsV 64 u =
  Ok (VFloat (ieeeOf 11 52 ((u % twoTo 64 + twoTo 64) % twoTo 64)))
floatOfBitsV 32 u =
  Ok (VFloat (ieeeOf 8 23 ((u % twoTo 32 + twoTo 32) % twoTo 32)))
floatOfBitsV n u = Abn

-- (the end of the digits of `t` from `i` on)
digitsEndV : String -> Int -> Int
digitsEndV t i =
  if 48 <= byteAt t i && byteAt t i <= 57 then digitsEndV t (i + 1) else i

-- (the integer the digits of `t` from `i` up to `j` are, after `acc`)
digitsValueV : String -> Int -> Int -> Int -> Int
digitsValueV t i j acc =
  if i >= j then acc else digitsValueV t (i + 1) j (acc * 10 + byteAt t i - 48)

-- (`x`, or its negation)
signedV : Bool -> Float64 -> Float64
signedV negative x = if negative then neg x else x

-- (the float of `n` bits nearest `m` times 10 to the power `e`)
decimalFloatV : Int -> Bool -> Int -> Int -> Float64
decimalFloatV 32 negative m e =
  signedV negative (Float32.toFloat (Float32.fromDecimal m e))
decimalFloatV n negative m e = signedV negative (Math.fromDecimal m e)

-- (the float, of `n` bits, nearest the decimal `t` -- a `-`, digits,
-- perhaps a point and digits, perhaps an exponent -- correctly
-- rounded; of other text, NaN)
decimalTextV : Int -> String -> Float64
decimalTextV n t =
  let a : Int = if byteAt t 0 == 45 then 1 else 0
  in let p : Int = digitsEndV t a
  in let f : Int = if byteAt t p == 46 then digitsEndV t (p + 1) else p
  in let x : Int = if byteAt t f == 101 || byteAt t f == 69 then f + 1 else f
  in let b : Int =
    if x > f && (byteAt t x == 43 || byteAt t x == 45) then x + 1 else x
  in let end : Int = digitsEndV t b
  in let places : Int = if f > p then f - p - 1 else 0
  in let power : Int =
    if byteAt t x == 45 && x > f then 0 - digitsValueV t b end 0
    else digitsValueV t b end 0
  in if p == a || f == p + 1 || (x > f && end == b) || end < strLength t
  then 0.0 /. 0.0
  else decimalFloatV
      n
      (a == 1)
      (digitsValueV t (p + 1) f (digitsValueV t a p 0))
      (power - places)

-- (... of a width the runtime has not, abandoned, as the runtime's)
floatOfDecimalV : Int -> String -> RVal
floatOfDecimalV 64 t = Ok (VFloat (decimalTextV 64 t))
floatOfDecimalV 32 t = Ok (VFloat (decimalTextV 32 t))
floatOfDecimalV n t = Abn

-- (a list's runes, their code points; of what is no list of runes, none)
runeCodes : List Val -> List Int
runeCodes [] = Nil
runeCodes (VRune c :: rest) = c :: runeCodes rest
runeCodes (_ :: rest) = runeCodes rest

intTake1 : (Int -> RVal) -> Val -> RVal
intTake1 f (VInt a) = f a
intTake1 f _ = notAnInt

int1 : (Int -> RVal) -> Val
int1 f = VFun (\d a -> rbind (a d) (\av -> intTake1 f av))

-- (an array's element type is given first, erased)
tyThen : Val -> Val
tyThen k = VFun (\d u -> Ok k)

arrTake1 : (Array Val -> RVal) -> Val -> RVal
arrTake1 f (VArr xs) = f xs
arrTake1 f _ = notAnArray

arr1 : (Array Val -> RVal) -> Val
arr1 f = VFun (\d a -> rbind (a d) (\av -> arrTake1 f av))

isFiniteF : Float64 -> Bool
isFiniteF x = x - x == 0.0

setAt : List Val -> Int -> Val -> List Val
setAt [] i x = Nil
setAt (y :: ys) i x = if i == 0 then x :: ys else y :: setAt ys (i - 1) x

genGo : Int -> Int -> Int -> Val -> (List Val -> RVal) -> RVal
genGo d j n f k =
  if j >= n then k Nil
  else rbind
      (app d f (okTh (VInt j)))
      (\v -> genGo d (j + 1) n f (\vs -> k (v :: vs)))

-- (a list's cells, builtin's `Cons`/`Nil`)
fromListV : Val -> List Val -> List Val
fromListV (VTag "Cons" [x, rest]) acc = fromListV rest (x :: acc)
fromListV _ acc = List.reverse acc

toListV : List Val -> Val
toListV [] = VTag "Nil" Nil
toListV (x :: xs) = VTag "Cons" [x, toListV xs]

-- (an index of a slice of `n` elements, as JavaScript's `slice` takes
-- it: clamped to them, a negative one counted from the end)
sliceAt : Int -> Int -> Int
sliceAt n i =
  if i < 0 then (if i + n < 0 then 0 else i + n) else if i > n then n else i

-- (the elements from `i` up to `j`, as `sliceAt` takes each)
sliceV : List Val -> Int -> Int -> List Val
sliceV xs i j =
  List.take
    (sliceAt (List.length xs) j - sliceAt (List.length xs) i)
    (List.drop (sliceAt (List.length xs) i) xs)

-- (the elements, `x` put in at `i`, clamped to them)
insertAtV : List Val -> Int -> Val -> List Val
insertAtV xs i x = List.append (List.take i xs) (x :: List.drop i xs)

-- (the elements, the one at `i` taken out; out of range, all of them)
removeAtV : List Val -> Int -> List Val
removeAtV xs i =
  if 0 <= i && i < List.length xs
  then List.append (List.take i xs) (List.drop (i + 1) xs)
  else xs

nthV : List Val -> Int -> Maybe Val
nthV [] i = Nothing
nthV (x :: xs) i = if i == 0 then Just x else nthV xs (i - 1)

-- An integer's bits, as two's complement has them, its sign extended for
-- ever: `f` of two integers' each pair of bits, the last pair (both
-- integers 0 or -1, of nothing but their sign) standing for every one
-- after it
intBits : (Int -> Int -> Int) -> Int -> Int -> Int
intBits f a b =
  if (a == 0 || a == -1) && (b == 0 || b == -1) then 0 - f (a % 2) (b % 2)
  else f (a % 2) (b % 2) + 2 * intBits f (a / 2) (b / 2)

-- (a shift by `f`, of a power of 2; by a negative count, one the other
-- way, by `back`)
intShift : (Int -> Int -> Int) -> (Int -> Int -> Int) -> Int -> Int -> RVal
intShift f back a b =
  if b < 0 then Ok (VInt (back a (Fixed.twoTo (0 - b))))
  else Ok (VInt (f a (Fixed.twoTo b)))

-- The hashes, as the runtime computes them:
-- FxHash's step over a string's bytes 8 at a time, then murmur3's
-- finish -- here on integers from 0 up to 2^64, each wrapped there

word64 : Int
word64 = Fixed.twoTo 64

-- (`a` xor `b`, both from 0)
xor64 : Int -> Int -> Int
xor64 a b = intBits (\x y -> (x + y) % 2) a b

-- (`h` xor `h` shifted right by 33)
fold33 : Int -> Int
fold33 h = xor64 h (h / Fixed.twoTo 33)

fmix64 : Int -> Int
fmix64 h =
  fold33
    ((fold33 ((fold33 h * 0xff51afd7ed558ccd) % word64) * 0xc4ceb9fe1a85ec53)
     % word64)

fxStep : Int -> Int -> Int
fxStep h w =
  (xor64 ((h * 32) % word64 + h / Fixed.twoTo 59) w * 0x517cc1b727220a95)
  % word64

-- (the bytes of `s` from `i` up to `k` taken, before them `w`: the first
-- the lowest)
wordFrom : String -> Int -> Int -> Int -> Int
wordFrom s i k w =
  if k < i then w else wordFrom s i (k - 1) (w * 256 + byteAt s k)

hashFrom : String -> Int -> Int -> Int
hashFrom s i h =
  if i + 8 <= strLength s
  then hashFrom s (i + 8) (fxStep h (wordFrom s i (i + 7) 0))
  else if i < strLength s then fxStep h (wordFrom s i (strLength s - 1) 0)
  else h

-- | a string's hash, the runtime's `strHash`
-- | >>> List.map strHashOf ["", "a", "hello, world"]
-- | Cons 0 (Cons 3104196977409597011 (Cons 3649460775222196455 Nil))
strHashOf : String -> Int
strHashOf s = fmix64 (hashFrom s 0 (strLength s)) / 4

-- | an integer's hash, the runtime's `intHash`: of its low 64 bits
-- | >>> List.map intHashOf [1, -1, 1180591620717411303429]
-- | Cons 3248695391556776651 (Cons 1814207941853616072 (Cons 3862599526612407645 Nil))
intHashOf : Int -> Int
intHashOf a = fmix64 ((a % word64 + word64) % word64) / 4

-- (how many bits of `m`, from 0, are set)
bitsSet : Int -> Int
bitsSet m = if m <= 0 then 0 else m % 2 + bitsSet (m / 2)

-- | a trie's step, the runtime's `trieSlot`: where the child the 5 bits
-- | of `h` from bit `s` on choose is among those of the bitmap `bm`, the
-- | bits set below its, or, where it is not one of them, -1 less that
-- | >>> List.map (\h -> trieSlotOf 37 h 0) [0, 2, 5, 3]
-- | Cons 0 (Cons 1 (Cons 2 (Cons (-3) Nil)))
trieSlotOf : Int -> Int -> Int -> Int
trieSlotOf bm h s =
  if (bm / Fixed.twoTo ((h / Fixed.twoTo s) % 32)) % 2 == 1
  then bitsSet (bm % Fixed.twoTo ((h / Fixed.twoTo s) % 32))
  else -1 - bitsSet (bm % Fixed.twoTo ((h / Fixed.twoTo s) % 32))

-- The fixed-width integers (heff.elab.fixed): each an integer of its type's
-- range, computed with as one and wrapped around to the type

-- (whether two integers' signs differ)
signsDiffer : Int -> Int -> Bool
signsDiffer a b = if a < 0 then b >= 0 else b < 0

-- (as C divides: rounding toward zero)
truncDiv : Int -> Int -> Int
truncDiv a b = if a % b /= 0 && signsDiffer a b then a / b + 1 else a / b

-- (the bits of two integers from 0 to 2^n - 1, each pair to one by `f`)
bitwise : (Int -> Int -> Int) -> Int -> Int -> Int -> Int
bitwise f n a b =
  if n == 0 then 0
  else f (a % 2) (b % 2) + 2 * bitwise f (n - 1) (a / 2) (b / 2)

-- (an integer type's operation of two values, as its bits: those of the
-- values from 0 to 2^bits - 1)
bitsOf : Fixed.Fixed -> (Int -> Int -> Int) -> Int -> Int -> RVal
bitsOf w f a b =
  Ok
    (VInt
       (Fixed.wrapFixed
          w
          (bitwise
             f
             (Fixed.fixedBits w)
             (a % Fixed.twoTo (Fixed.fixedBits w))
             (b % Fixed.twoTo (Fixed.fixedBits w)))))

wrapV : Fixed.Fixed -> Int -> RVal
wrapV w n = Ok (VInt (Fixed.wrapFixed w n))

-- (a shift's amount, of a count from 0: modulo the bits)
shiftOf : Fixed.Fixed -> Int -> Int
shiftOf w b = Fixed.twoTo (b % Fixed.fixedBits w)

fixedInt2 : Fixed.Fixed -> Fixed.FixedOp -> Int -> Int -> RVal
fixedInt2 w OpAdd a b = wrapV w (a + b)
fixedInt2 w OpSub a b = wrapV w (a - b)
fixedInt2 w OpMul a b = wrapV w (a * b)
fixedInt2 w OpDiv a b = if b == 0 then wrapV w 0 else wrapV w (truncDiv a b)
fixedInt2 w OpRem a b =
  if b == 0 then wrapV w a else wrapV w (a - b * truncDiv a b)
fixedInt2 w OpEq a b = Ok (boolV (a == b))
fixedInt2 w OpLt a b = Ok (boolV (a < b))
fixedInt2 w OpLe a b = Ok (boolV (a <= b))
fixedInt2 w OpAnd a b = bitsOf w (\x y -> x * y) a b
fixedInt2 w OpOr a b = bitsOf w (\x y -> if x + y > 0 then 1 else 0) a b
fixedInt2 w OpXor a b = bitsOf w (\x y -> (x + y) % 2) a b
-- (by a negative count, of a signed type, a shift the other way by its
-- size; right, rounding down: arithmetic, of a negative value)
fixedInt2 w OpShl a b =
  if b < 0 then Ok (VInt (a / shiftOf w (0 - b))) else wrapV w (a * shiftOf w b)
fixedInt2 w OpShr a b =
  if b < 0 then wrapV w (a * shiftOf w (0 - b)) else Ok (VInt (a / shiftOf w b))
fixedInt2 w op a b =
  Bug ("no primitive " ^ Fixed.fixedPrimName (Fixed.mkFixedPrim w op))

fixedInt1 : Fixed.Fixed -> Fixed.FixedOp -> Int -> RVal
fixedInt1 w OpShow a = Ok (VStr (debug a))
fixedInt1 w OpFromInt a = wrapV w a
fixedInt1 w OpToInt a = Ok (VInt a)
fixedInt1 w op a =
  Bug ("no primitive " ^ Fixed.fixedPrimName (Fixed.mkFixedPrim w op))

-- `Float32`: the host's

f32Take1 : (Float32 -> RVal) -> Val -> RVal
f32Take1 f (VFloat32 a) = f a
f32Take1 f _ = notAFloat32

f32V1 : (Float32 -> RVal) -> Val
f32V1 f = VFun (\d a -> rbind (a d) (\av -> f32Take1 f av))

f32Take2 : (Float32 -> Float32 -> RVal) -> Val -> Val -> RVal
f32Take2 f (VFloat32 a) (VFloat32 b) = f a b
f32Take2 f _ _ = notAFloat32

f32V2 : (Float32 -> Float32 -> RVal) -> Val
f32V2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> f32Take2 f av bv)))))

f32Ok : Float32 -> RVal
f32Ok x = Ok (VFloat32 x)

-- (of what is not finite, 0)
f32Floor : Float32 -> RVal
f32Floor a =
  if isFiniteF (Float32.toFloat a) then Ok (VInt (Float32.floor a))
  else Ok (VInt 0)

float32V : Fixed.FixedOp -> Val
float32V OpAdd = f32V2 (\a b -> f32Ok (Float32.add a b))
float32V OpSub = f32V2 (\a b -> f32Ok (Float32.sub a b))
float32V OpMul = f32V2 (\a b -> f32Ok (Float32.mul a b))
float32V OpDiv = f32V2 (\a b -> f32Ok (Float32.div a b))
float32V OpEq = f32V2 (\a b -> Ok (boolV (Float32.eq a b)))
float32V OpLt = f32V2 (\a b -> Ok (boolV (Float32.lt a b)))
float32V OpLe = f32V2 (\a b -> Ok (boolV (Float32.le a b)))
float32V OpSqrt = f32V1 (\a -> f32Ok (Float32.sqrt a))
float32V OpShow = f32V1 (\a -> Ok (VStr (debug a)))
float32V OpFromFloat = float1 (\a -> f32Ok (Float32.fromFloat a))
float32V OpToFloat = f32V1 (\a -> Ok (VFloat (Float32.toFloat a)))
float32V OpFromInt = int1 (\a -> f32Ok (Float32.fromInt a))
float32V OpFloor = f32V1 f32Floor
float32V op = VFun (\d a -> Bug ("no primitive float32" ^ Fixed.opName op))

fixedPrimV : Fixed.FixedPrim -> Val
fixedPrimV p =
  if Fixed.isFloat32 p.fixed then float32V p.op
  else if Fixed.opArity p.op == 2 then int2 (fixedInt2 p.fixed p.op)
  else int1 (fixedInt1 p.fixed p.op)

prim : Prim -> Val
prim IntAdd = int2 (\a b -> Ok (VInt (a + b)))
prim IntSub = int2 (\a b -> Ok (VInt (a - b)))
prim IntMul = int2 (\a b -> Ok (VInt (a * b)))
-- (by zero, 0, and the remainder the dividend: a division is total)
prim IntDiv = int2 (\a b -> if b == 0 then Ok (VInt 0) else Ok (VInt (a / b)))
prim IntMod = int2 (\a b -> if b == 0 then Ok (VInt a) else Ok (VInt (a % b)))
prim IntEq = int2 (\a b -> Ok (boolV (a == b)))
prim IntLt = int2 (\a b -> Ok (boolV (a < b)))
prim IntLe = int2 (\a b -> Ok (boolV (a <= b)))
prim IntShow = int1 (\a -> Ok (VStr (debug a)))
-- (the compiler's own host's, as the program would be run here)
prim OnWindows = VFun (\d a -> Ok (boolV (onWindows MkUnit)))
prim IntAnd = int2 (\a b -> Ok (VInt (intBits (\x y -> x * y) a b)))
prim IntOr =
  int2
    (\a b -> Ok (VInt (intBits (\x y -> if x + y > 0 then 1 else 0) a b)))
prim IntXor = int2 (\a b -> Ok (VInt (intBits (\x y -> (x + y) % 2) a b)))
prim IntShl = int2 (intShift (\a k -> a * k) (\a k -> a / k))
prim IntShr = int2 (intShift (\a k -> a / k) (\a k -> a * k))
prim FloatAdd = float2 (\a b -> Ok (VFloat (a + b)))
prim FloatSub = float2 (\a b -> Ok (VFloat (a - b)))
prim FloatMul = float2 (\a b -> Ok (VFloat (a * b)))
prim FloatDiv = float2 (\a b -> Ok (VFloat (a /. b)))
prim FloatEq = float2 (\a b -> Ok (boolV (a == b)))
prim FloatLt = float2 (\a b -> Ok (boolV (a < b)))
prim FloatLe = float2 (\a b -> Ok (boolV (a <= b)))
prim FloatShow = float1 (\a -> Ok (VStr (debug a)))
prim FloatFromInt = int1 (\a -> Ok (VFloat (toFloat a)))
prim FloatSqrt = float1 (\a -> Ok (VFloat (sqrt a)))
-- (of what is not finite, 0)
prim FloatFloor =
  float1 (\a -> if isFiniteF a then Ok (VInt (floor a)) else Ok (VInt 0))
prim FloatSin = float1 (\a -> Ok (VFloat (Math.sin a)))
prim FloatCos = float1 (\a -> Ok (VFloat (Math.cos a)))
prim FloatTan = float1 (\a -> Ok (VFloat (Math.tan a)))
prim FloatAsin = float1 (\a -> Ok (VFloat (Math.asin a)))
prim FloatAcos = float1 (\a -> Ok (VFloat (Math.acos a)))
prim FloatAtan = float1 (\a -> Ok (VFloat (Math.atan a)))
prim FloatAtan2 = float2 (\a b -> Ok (VFloat (Math.atan2 a b)))
prim FloatExp = float1 (\a -> Ok (VFloat (Math.exp a)))
prim FloatLog = float1 (\a -> Ok (VFloat (Math.log a)))
prim FloatPow = float2 (\a b -> Ok (VFloat (Math.pow a b)))
prim ArrayLength =
  tyThen (arr1 (\xs -> Ok (VInt (List.length (Array.toList xs)))))
prim ArrayIndex =
  tyThen
    (arr1
       (\xs ->
          Ok
            (int1
               (\i ->
                  if 0 <= i && i < List.length (Array.toList xs)
                  then (case nthV (Array.toList xs) i of
                        Just v -> Ok v
                        Nothing -> Bug "an index in range, of no element")
                  else Abn))))
prim ArraySet =
  tyThen
    (arr1
       (\xs ->
          Ok
            (int1
               (\i ->
                  Ok
                    (VFun
                       (\d x ->
                          rbind
                            (x d)
                            (\xv ->
                               if 0 <= i
                                  && i < List.length (Array.toList xs)
                               then Ok
                                   (VArr
                                      (Array.fromList
                                         (setAt (Array.toList xs) i xv)))
                               else Ok (VArr xs))))))))
prim ArrayGenerate =
  tyThen
    (int1
       (\n ->
          Ok
            (VFun
               (\d f ->
                  rbind
                    (f d)
                    (\fv ->
                       genGo
                         d
                         0
                         n
                         fv
                         (\vs -> Ok (VArr (Array.fromList vs))))))))
prim ArrayFromList =
  tyThen
    (VFun
       (\d l ->
          rbind
            (l d)
            (\lv -> Ok (VArr (Array.fromList (fromListV lv Nil))))))
prim ArrayToList = tyThen (arr1 (\xs -> Ok (toListV (Array.toList xs))))
prim ArrayReplicate =
  tyThen
    (int1
       (\n ->
          Ok
            (VFun
               (\d x ->
                  rbind
                    (x d)
                    (\xv ->
                       Ok (VArr (Array.fromList (List.replicate n xv))))))))
prim ArraySlice =
  tyThen
    (arr1
       (\xs ->
          Ok
            (int1
               (\i ->
                  Ok
                    (int1
                       (\j ->
                          Ok
                            (VArr
                               (Array.fromList
                                  (sliceV (Array.toList xs) i j)))))))))
prim ArrayAppend =
  tyThen
    (arr1
       (\xs ->
          Ok
            (arr1
               (\ys ->
                  Ok
                    (VArr
                       (Array.fromList
                          (List.append
                             (Array.toList xs)
                             (Array.toList ys))))))))
prim ArrayInsertAt =
  tyThen
    (arr1
       (\xs ->
          Ok
            (int1
               (\i ->
                  Ok
                    (VFun
                       (\d x ->
                          rbind
                            (x d)
                            (\xv ->
                               Ok
                                 (VArr
                                    (Array.fromList
                                       (insertAtV
                                          (Array.toList xs)
                                          i
                                          xv))))))))))
prim ArrayRemoveAt =
  tyThen
    (arr1
       (\xs ->
          Ok
            (int1
               (\i ->
                  Ok
                    (VArr
                       (Array.fromList (removeAtV (Array.toList xs) i)))))))
prim ArrayPush =
  tyThen
    (arr1
       (\xs ->
          Ok
            (VFun
               (\d x ->
                  rbind
                    (x d)
                    (\xv ->
                       Ok
                         (VArr
                            (Array.fromList
                               (List.append
                                  (Array.toList xs)
                                  [xv]))))))))
prim ArrayReserve = tyThen (arr1 (\xs -> Ok (int1 (\k -> Ok (VArr xs)))))
prim StrAppend = str2 (\a b -> Ok (VStr (a ^ b)))
prim StrLength = str1 (\a -> Ok (VInt (strLength a)))
prim StrSlice =
  str1
    (\a -> Ok (int1 (\i -> Ok (int1 (\j -> Ok (VStr (strSlice a i j)))))))
prim StrEq = str2 (\a b -> Ok (boolV (strEq a b)))
prim StrLt = str2 (\a b -> Ok (boolV (strLt a b)))
prim StrCompare =
  str2
    (\a b -> Ok (VInt (if strLt a b then -1 else if strEq a b then 0 else 1)))
prim StrHash = str1 (\a -> Ok (VInt (strHashOf a)))
prim StrHashRange =
  str1
    (\a ->
       Ok
         (int1
            (\i -> Ok (int1 (\j -> Ok (VInt (strHashOf (strSlice a i j))))))))
prim StrEqRange =
  str2
    (\t a ->
       Ok
         (int1
            (\i -> Ok (int1 (\j -> Ok (boolV (strEq t (strSlice a i j))))))))
prim IntHash = int1 (\a -> Ok (VInt (intHashOf a)))
prim TrieSlot =
  int1
    (\bm -> Ok (int1 (\h -> Ok (int1 (\s -> Ok (VInt (trieSlotOf bm h s)))))))
prim StrFind =
  str2
    (\n a ->
       Ok
         (int1
            (\i -> Ok (VInt (fromMaybe (-1) (indexOf n a (max 0 i)))))))
-- (a string as bytes: the host's strings, UTF-8 bytes as the
-- interpreted program's are; a byte, a `UInt8`, an integer from 0 to
-- 255)
prim StrByteAt = str1 (\a -> Ok (int1 (\i -> Ok (VInt (byteAt a i)))))
prim StrFromByte = int1 (\c -> Ok (VStr (fromByte (UInt8.fromInt c))))
prim StrRuneAt =
  str1
    (\a -> Ok (int1 (\i -> Ok (VRune (Rune.toInt (runeAt a i).rune)))))
prim StrRuneWidth = str1 (\a -> Ok (int1 (\i -> Ok (VInt (runeAt a i).width))))
prim StrRuneCount = str1 (\a -> Ok (VInt (Rune.count a)))
prim StrToJS = str1 (\a -> Ok (VStr (fromRunes (runes a))))
prim StrFromJS = str1 (\a -> Ok (VStr a))
-- (`Bytes`, a string of them: a byte a `UInt8`, an integer from 0 to
-- 255; made text as `rune`'s `toValid` makes a string)
prim BytesLength = bytes1 (\a -> Ok (VInt (strLength a)))
prim BytesAt =
  bytes1
    (\a ->
       Ok
         (int1
            (\i ->
               if 0 <= i && i < strLength a then Ok (VInt (byteAt a i))
               else Abn)))
prim BytesSlice =
  bytes1
    (\a -> Ok (int1 (\i -> Ok (int1 (\j -> Ok (VBytes (strSlice a i j)))))))
prim BytesAppend = bytes2 (\a b -> Ok (VBytes (a ^ b)))
prim BytesConcat =
  VFun (\d l -> rbind (l d) (\lv -> bytesJoined (fromListV lv Nil) ""))
prim BytesEq = bytes2 (\a b -> Ok (boolV (strEq a b)))
prim BytesFromList =
  VFun
    (\d l ->
       rbind (l d) (\lv -> Ok (VBytes (byteString (fromListV lv Nil) ""))))
prim BytesToList =
  bytes1
    (\a ->
       Ok
         (toListV
            (List.map
               (\i -> VInt (byteAt a i))
               (List.range 0 (strLength a - 1)))))
prim BytesFromString = str1 (\a -> Ok (VBytes a))
prim BytesAsString = bytes1 (\a -> Ok (VStr a))
prim BytesToString = bytes1 (\a -> Ok (VStr (Rune.toValid a)))
prim BytesIntAt =
  bytes1
    (\a ->
       Ok
         (int1
            (\o -> Ok (int1 (\n -> Ok (int1 (\f -> bytesIntAtV a o n f)))))))
prim BytesOfInt =
  int1
    (\n -> Ok (int1 (\f -> Ok (int1 (\v -> bytesOfIntV n f v)))))
prim BytesHasAt =
  bytes1
    (\a ->
       Ok
         (int1
            (\o ->
               Ok
                 (bytes1
                    (\b ->
                       Ok
                         (boolV
                            (0 <= o
                             && o + strLength b <= strLength a
                             && strEq
                               (strSlice a o (o + strLength b))
                               b)))))))
prim BytesFind =
  bytes2
    (\n a ->
       Ok
         (int1
            (\i -> Ok (VInt (fromMaybe (-1) (indexOf n a (max 0 i)))))))
-- (`Bits`: how many, and the bytes they are in)
prim BitsLength = bits1 (\n s -> Ok (VInt n))
prim BitsIntAt =
  bits1
    (\m s ->
       Ok
         (int1
            (\o -> Ok (int1 (\n -> Ok (int1 (\f -> intAtV s m o n f)))))))
prim BitsOfInt =
  int1 (\n -> Ok (int1 (\f -> Ok (int1 (\v -> bitsOfIntV n f v)))))
prim BitsConcat =
  VFun (\d l -> rbind (l d) (\lv -> bitsJoined (fromListV lv Nil) 0 ""))
prim BitsSlice =
  bits1
    (\m s ->
       Ok
         (int1
            (\o ->
               Ok
                 (int1
                    (\n -> bitsSliceV m s o n)))))
prim BitsOfBytes = bytes1 (\a -> Ok (VBits (strLength a * 8) a))
prim BitsBytes = bits1 (\n s -> if n % 8 == 0 then Ok (VBytes s) else Abn)
prim BitsEq =
  bits1
    (\n s -> Ok (bits1 (\m t -> Ok (boolV (n == m && strEq s t)))))
prim FloatBits = int1 (\n -> Ok (float1 (\x -> floatBitsV n x)))
prim FloatOfBits = int1 (\n -> Ok (int1 (\u -> floatOfBitsV n u)))
prim FloatOfDecimal =
  int1
    (\n ->
       Ok
         (str1
            (\s ->
               Ok
                 (int1
                    (\i ->
                       Ok (int1 (\j -> floatOfDecimalV n (strSlice s i j))))))))
prim RuneEq = rune2 (\a b -> Ok (boolV (a == b)))
prim RuneLt = rune2 (\a b -> Ok (boolV (a < b)))
prim RuneLe = rune2 (\a b -> Ok (boolV (a <= b)))
prim RuneToInt = rune1 (\a -> Ok (VInt a))
-- (bench's: the value as it is, its type given first)
prim Keep = tyThen (VFun (\d a -> a d))
-- (a failure said: here, as an abandon, its words not kept)
prim Panic = tyThen (str1 (\a -> Abn))
-- (wrapped around to 32 bits, as an `Int32` is)
prim RuneFromInt = int1 (\a -> Ok (VRune (Fixed.wrapFixed I32 a)))
-- (the host's: its strings' runes, UTF-8, read and written)
prim StrRunes =
  str1
    (\a -> Ok (toListV (List.map (\r -> VRune (Rune.toInt r)) (runes a))))
prim StrOfRunes =
  VFun
    (\d l ->
       rbind
         (l d)
         (\lv ->
            Ok
              (VStr
                 (fromRunes
                    (List.map
                       Rune.fromInt
                       (runeCodes (fromListV lv Nil)))))))
prim (OfFixed w op) = fixedPrimV (Fixed.mkFixedPrim w op)
prim p = VFun (\d a -> Bug ("no primitive " ^ primName p))

type Env = { local : List (Th RVal), global : OrdMap.OrdMap String (Th RVal) }

bindLocal : Env -> Th RVal -> Env
bindLocal e v = { local = v :: e.local, global = e.global }

bindVals : Env -> List Val -> Env
bindVals e vs = List.foldl (\e2 v -> bindLocal e2 (okTh v)) e vs

nthTh : List (Th RVal) -> Int -> Maybe (Th RVal)
nthTh [] i = Nothing
nthTh (x :: xs) i =
  if i == 0 then Just x else if i < 0 then Nothing else nthTh xs (i - 1)

-- (evaluated fields and arguments, in order; the first abandon wins)
evalEach : (Syntax.Tm -> RVal) -> List Syntax.Tm -> (List Val -> RVal) -> RVal
evalEach ev [] k = k Nil
evalEach ev (t :: rest) k =
  rbind (ev t) (\v -> evalEach ev rest (\vs -> k (v :: vs)))

evalFields : (Syntax.Tm -> RVal)
           -> List (Pair String Syntax.Tm)
           -> (List (Pair String Val) -> RVal)
           -> RVal
evalFields ev [] k = k Nil
evalFields ev (MkPair l t :: rest) k =
  rbind (ev t) (\v -> evalFields ev rest (\vs -> k (MkPair l v :: vs)))

evalIn : Int -> Env -> Syntax.Tm -> RVal
evalIn d e t =
  if diverges d then Div
  else case t of
    SLocal i -> case nthTh e.local i of
      Just v -> v d
      Nothing -> Bug ("local " ^ debug i ^ " is not in scope")
    SGlobal x -> case OrdMap.lookup e.global x of
      Just v -> v d
      Nothing -> Bug (x ^ " is not in scope")
    SLam _ (MkAbs _ body) ->
      Ok (VFun (\dc v -> evalIn (onward dc) (bindLocal e v) body))
    SLam _ (AbsConst body) -> Ok (VFun (\dc u -> evalIn (onward dc) e body))
    SApp t1 t2 ->
      rbind
        (evalIn (nested d) e t1)
        (\f -> rbind (evalIn (nested d) e t2) (\a -> app d f (okTh a)))
    SCons fs ->
      evalFields
        (\t2 -> evalIn (nested d) e t2)
        (Dict.toList fs)
        (\vs -> Ok (VCons (Dict.fromList vs)))
    SProj t2 x -> rbind (evalIn (nested d) e t2) (\v -> projV v x)
    STag x ts ->
      evalEach
        (\t2 -> evalIn (nested d) e t2)
        (Array.toList ts)
        (\vs -> Ok (VTag x vs))
    SMatch scrut cases ->
      rbind (evalIn (nested d) e scrut) (\v -> case v of
        VTag x vs ->
          (case Dict.lookup cases x of
           Just (MkPair _ body) -> evalIn (onward d) (bindVals e vs) body
           -- (the default case, of the tags no other names: it binds none
           -- of their arguments)
           Nothing -> case Dict.lookup cases "_" of
             Just (MkPair _ body) -> evalIn (onward d) e body
             Nothing -> Bug ("no case for " ^ x))
        VErased -> Ok VErased
        _ -> Bug "a case of what is not a tag")
    SCode _ -> Ok VErased
    SIs t2 -> evalIn (onward d) e t2
    SAbandon -> Abn
    SRec t2 -> evalIn (onward d) e t2
    -- (the definition itself is its own body, evaluated again whenever it
    -- is called for)
    SFix ty (MkAbs x body) ->
      evalIn
        (onward d)
        (bindLocal e (\dc -> evalIn dc e (SFix ty (MkAbs x body))))
        body
    SFix _ (AbsConst body) -> evalIn (onward d) e body
    SPrim x -> Ok (prim x)
    SLitInt i -> Ok (VInt i)
    SLitFloat x -> Ok (VFloat x)
    SLitString s -> Ok (VStr s)
    SLitBytes s -> Ok (VBytes s)
    SLitRune c -> Ok (VRune c)
    -- (a fixed-width integer is an integer, of its type's range)
    SLitFixed _ i -> Ok (VInt i)
    SLitFloat32 x -> Ok (VFloat32 (Float32.fromFloat x))
    SImplicit _ t2 -> evalIn (onward d) e t2
    SSpecialize _ _ _ -> Ok VErased
    _ -> Bug "a term that is not evaluated"

-- Results, as the tools show them
--------------------------------------------------------------------------------

data EvalResult = RSucceeded Val | RAbandoned | RDiverged | RBug String

scalarV : Val -> String
scalarV (VFun _) = "#fun"
scalarV (VInt i) = debug i
scalarV (VFloat x) = debug x
scalarV (VFloat32 x) = debug x
scalarV (VStr s) = RuneUtil.quoteString s
scalarV (VRune c) = RuneUtil.quote c
scalarV (VBytes s) = RuneUtil.quoteBytes s
scalarV (VBits n s) = RuneUtil.quoteBits n s
scalarV VErased = "#erased"
scalarV _ = "#value"

-- | a list's items, `Cons a (Cons b Nil)` as `[a, b]` writes them; not
-- | one, a chain that does not end in `Nil`
listValsGo : Val -> List Val -> Maybe (List Val)
listValsGo (VTag "Nil" []) acc = Just (List.reverse acc)
listValsGo (VTag "Cons" [x, rest]) acc = listValsGo rest (x :: acc)
listValsGo _ acc = Nothing

-- | a value as the tools show it: a list as `[a, b]`, and a tag with
-- | arguments parenthesized where it is an argument, so what is shown
-- | reads back as the same value
showValGo : Bool -> Val -> String
showValGo inArg (VTag x vs) = case listValsGo (VTag x vs) Nil of
  Just items ->
    "[" ^ joinWith ", " (List.map (\a -> showValGo False a) items) ^ "]"
  Nothing ->
    if List.null vs then x
    else if inArg
    then "("
      ^ x
      ^ joinWith "" (List.map (\a -> " " ^ showValGo True a) vs)
      ^ ")"
    else x ^ joinWith "" (List.map (\a -> " " ^ showValGo True a) vs)
showValGo inArg (VCons fs) =
  "{ "
  ^ joinWith
    ", "
    (List.map
       (\(p : Pair String Val) -> fst p ^ " = " ^ showValGo False (snd p))
       (Dict.toList fs))
  ^ " }"
showValGo inArg (VArr xs) =
  "["
  ^ joinWith ", " (List.map (\a -> showValGo False a) (Array.toList xs))
  ^ "]"
-- (a negative number, an argument: `Just (-7)`)
showValGo inArg v =
  if inArg && startsWith "-" (scalarV v) then "(" ^ scalarV v ^ ")"
  else scalarV v

-- | >>> showVal (VTag "Just" [toListV [VInt 1, VInt (-2)]])
-- | "Just [1, -2]"
-- | >>> showVal (VTag "Cons" [VTag "Nil" [], VTag "Nil" []])
-- | "[[]]"
-- | >>> showVal (VTag "Cons" [VInt 1, VTag "Just" [VInt 2]])
-- | "Cons 1 (Just 2)"
showVal : Val -> String
showVal v = showValGo False v

showResult : EvalResult -> String
showResult (RSucceeded v) = showVal v
showResult RAbandoned = "<abandoned>"
showResult RDiverged = "<diverged>"
showResult (RBug what) = "<compiler bug: " ^ what ^ ">"

-- Globals
--------------------------------------------------------------------------------

type GlobalEnv = OrdMap.OrdMap String (Th RVal)

-- (the definition itself is local 0: forcing it ties the knot)
fixThunk : GlobalEnv -> Syntax.Tm -> Th RVal
fixThunk g t = \d -> evalIn (nested d) { local = [fixThunk g t], global = g } t

-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = OrdMap.empty } (SApp (SApp (SPrim IntAdd) (SLitInt 2)) (SLitInt 3))))
-- | "5"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = OrdMap.empty } (SApp (SApp (SPrim IntDiv) (SLitInt 2)) (SLitInt 0))))
-- | "0"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = OrdMap.empty } (SApp (SApp (SPrim IntShl) (SLitInt 2)) (SLitInt -1))))
-- | "1"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = OrdMap.empty } SAbandon))
-- | "<abandoned>"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = OrdMap.empty } (SApp (SLitInt 1) (SLitInt 2))))
-- | "<compiler bug: applied what is not a function>"
resultOf : RVal -> EvalResult
resultOf (Ok v) = RSucceeded v
resultOf Abn = RAbandoned
resultOf Div = RDiverged
resultOf (Bug what) = RBug what

-- | a value given `n` arguments that are types first -- erased where it
-- | is compiled, so given as nothing -- as it is shown: `[]` of
-- | `{a : Type} -> List a`, as the compiled code has it
applyErased : Int -> EvalResult -> EvalResult
applyErased n (RSucceeded (VFun f)) =
  if n <= 0 then RSucceeded (VFun f)
  else applyErased (n - 1) (resultOf (f 0 (okTh VErased)))
applyErased n r = r

withR : {a : Type} -> RVal -> (RVal -> a) -> a
withR r f = f r

evalGlobalsGo : (String -> Bool)
              -> GlobalEnv
              -> List (Pair String Globals.Entry)
              -> List (Pair String EvalResult)
              -> List (Pair String EvalResult)
evalGlobalsGo wanted ge [] acc = List.reverse acc
evalGlobalsGo wanted ge (MkPair x entry :: rest) acc =
  withR
    (fixThunk ge entry.syntax 0)
    (\r ->
       evalGlobalsGo
         wanted
         (OrdMap.insert ge x (\d -> r))
         rest
         (if wanted x then MkPair x (resultOf r) :: acc else acc))

-- | every global is evaluated once, in declaration order, its value
-- | shared by every later reference (sharing is the eager walk itself
-- | -- sound, because an `abandon` is a value, `Abn`, not the end of
-- | the run, and a module's definitions only ever see the ones before
-- | them)
evalGlobalsWhere : (String -> Bool)
                 -> Globals.Globals
                 -> List (Pair String EvalResult)
evalGlobalsWhere wanted gs =
  evalGlobalsGo wanted OrdMap.empty (Globals.globalsList gs) Nil

-- (the globals `roots` reach, each by the globals its definition
-- mentions: a walk, not a recursion)
reachGlobals : Globals.Globals
             -> OrdMap.OrdMap String Unit
             -> List String
             -> OrdMap.OrdMap String Unit
reachGlobals gs seen [] = seen
reachGlobals gs seen (k :: rest) =
  if OrdMap.member seen k then reachGlobals gs seen rest
  else reachGlobals
      gs
      (OrdMap.insert seen k MkUnit)
      (List.append
         (case Globals.lookupEntry gs k of
          Just entry -> Rename.globalsInEl entry.syntax
          Nothing -> Nil)
         rest)

elemStrI : String -> List String -> Bool
elemStrI x [] = False
elemStrI x (y :: rest) = strEq x y || elemStrI x rest

-- (the entries among `reached`, in declaration order, the roots' results kept)
evalReachedIn : List String
              -> OrdMap.OrdMap String Unit
              -> Globals.Globals
              -> List (Pair String EvalResult)
evalReachedIn roots reached gs =
  evalGlobalsGo
    (\k -> elemStrI k roots)
    OrdMap.empty
    (List.keepIf (\p -> OrdMap.member reached (fst p)) (Globals.globalsList gs))
    Nil

-- | the `roots` evaluated, as `evalGlobalsWhere` evaluates them, but
-- | with only the globals they reach evaluated before them: a few
-- | definitions of a large program -- a description read where the
-- | program is compiled -- without the whole program's being evaluated
evalReached : Globals.Globals -> List String -> List (Pair String EvalResult)
evalReached gs roots =
  evalReachedIn roots (reachGlobals gs OrdMap.empty roots) gs

globalEnvGo : GlobalEnv -> List (Pair String Globals.Entry) -> GlobalEnv
globalEnvGo ge [] = ge
globalEnvGo ge (MkPair x entry :: rest) =
  withR
    (fixThunk ge entry.syntax 0)
    (\r -> globalEnvGo (OrdMap.insert ge x (\d -> r)) rest)

-- | every global evaluated once, as `evalGlobalsWhere` evaluates them:
-- | what entries that are no globals (watches) are evaluated in, each
-- | without evaluating the globals again
globalEnv : Globals.Globals -> GlobalEnv
globalEnv gs = globalEnvGo OrdMap.empty (Globals.globalsList gs)

-- | an entry evaluated in the globals evaluated, as it would be the last
-- | of them
evalEntryIn : GlobalEnv -> Globals.Entry -> EvalResult
evalEntryIn ge entry = resultOf (fixThunk ge entry.syntax 0)
