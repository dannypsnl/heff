-- Separate compilation, as a cache the compiler manages; this is the
-- pure side: what a cache file says, and whether it may be believed.
-- A module whose making is unchanged since it last elaborated clean is
-- thawed from `.heff/<versionDir>/<module>.hc` instead of elaborated
-- again (`heff.build.commands` does the reading and writing).
--
-- What a module is made of is tracked at the definitions it uses, not
-- at whole imports: a definition's hash covers its core syntax and,
-- transitively, the definitions it mentions; a module records the hash
-- of each outside definition its own mention, and one hash per direct
-- import for what its parse takes (the names defined, the fixities) and
-- what its instance searches may find (the instances declared, each by
-- its type).
-- `version` (and `versionDir` with it) must be bumped when elaboration
-- changes, there being no build stamp to read from inside.

module heff.build.cache

import array as Array
import heff.build.decoder
import heff.build.driver as Driver
import heff.syntax.fixity as Fixity
import heff.elab.globals as Globals
import heff.syntax.import as Import
import heff.elab.params as Params
import heff.elab.rename as Rename
import heff.build.serial as Serial
import heff.elab.toplevel as TopLevel
import std.ordmap as OrdMap

version : String
version = "heff-cache-port/119"

-- | the directory under `.heff/` this version's cache files are in: a
-- | compiler of another version (the seed, the first stage) keeps its
-- | own beside it, and neither throws the other's away
versionDir : String
versionDir = "v119"

-- Hashing (private to this cache): two polynomial hashes, each modulo a
-- prime below 2^31, so that every step stays a machine word (no big
-- integer, on either backend)
--------------------------------------------------------------------------------

hashStepA : Int -> Int -> Int
hashStepA h c = (h * 1000003 + c + 1) % 2147483647

hashStepB : Int -> Int -> Int
hashStepB h c = (h * 999983 + c + 1) % 2147483629

hashGo : String -> Int -> Int -> Int -> String
hashGo s i a b =
  if i >= strLength s then debug a ^ "-" ^ debug b
  else hashGo s (i + 1) (hashStepA a (byteAt s i)) (hashStepB b (byteAt s i))

-- | >>> strEq (strHash "abc") (strHash "abc") && not (strEq (strHash "abc") (strHash "abd"))
-- | True
strHash : String -> String
strHash s = hashGo s 0 5381 7919

-- Hashes of the definitions, and of what a parse takes
--------------------------------------------------------------------------------

hashOf : OrdMap.OrdMap String String -> String -> String
hashOf m k = fromMaybe "?" (OrdMap.lookup m k)

nubCa : List String -> List String
nubCa [] = Nil
nubCa (x :: xs) = x :: nubCa (List.keepIf (\y -> not (strEq y x)) xs)

refsOf : Globals.Entry -> List String
refsOf e =
  List.sort
    (nubCa
       (List.append
          (Rename.globalsInTy e.tySyntax)
          (Rename.globalsInEl e.syntax)))

-- (how a module's claim exposes a definition of it: an importer may
-- name it, write its tags, or neither -- so a change of the claim is a
-- change of the definition to what is made of it)
exposureSig : Maybe (List Import.Exposed) -> String -> String
exposureSig (Just es) x =
  if List.any (\(e : Import.Exposed) -> strEq e.name x && e.tags) es
  then "\n(..)"
  else if List.any (\(e : Import.Exposed) -> strEq e.name x) es then "\n+"
  else "\n-"
exposureSig Nothing x = ""

defHashOne : OrdMap.OrdMap String String
           -> Driver.Checked
           -> Driver.Own
           -> OrdMap.OrdMap String String
defHashOne m c o =
  if OrdMap.member m o.key then m
  else case Globals.lookupEntry c.top.globals o.key of
    Just e ->
      OrdMap.insert
        m
        o.key
        (strHash
           (Serial.encodeTy e.tySyntax
            ^ "\n"
            ^ Serial.encodeEl e.syntax
            ^ "\n"
            ^ joinWith "," (List.map (\k -> k ^ ":" ^ hashOf m k) (refsOf e))
            ^ exposureSig c.exposes o.name))
    Nothing -> m

-- the module itself, a struct of its definitions, and its theory:
-- mentioned bare (`M`), they hash as all of it
wholeHash : OrdMap.OrdMap String String
          -> Driver.Checked
          -> OrdMap.OrdMap String String
wholeHash m c =
  OrdMap.insert
    (OrdMap.insert
       m
       (c.module ^ "#T")
       (strHash
          (joinWith
             ","
             (List.map
                (\(o : Driver.Own) -> o.key ^ ":" ^ hashOf m o.key)
                (Driver.exposedOwn c)))))
    (c.module ^ "#")
    (strHash
       (joinWith
          ","
          (List.map
             (\(o : Driver.Own) -> o.key ^ ":" ^ hashOf m o.key)
             (Driver.exposedOwn c))))

-- | a thawed module's hashes: each definition's as it was frozen -- what
-- | it is made of being unchanged, so is its hash -- not computed again
thawedHashesInto : OrdMap.OrdMap String String
                 -> Driver.Thawed
                 -> Driver.Checked
                 -> OrdMap.OrdMap String String
thawedHashesInto hs th c =
  wholeHash
    (List.foldl
       (\m p -> case p of
        MkPair k h ->
          if OrdMap.member m k then m
          else OrdMap.insert m k h)
       hs
       th.hashes)
    c

-- | each definition's hash: its core syntax, and the hashes of the
-- | definitions it mentions -- so a hash covers a definition's making,
-- | transitively.  (A primitive declared again is the same one: the
-- | first hash stands.)
defHashesInto : OrdMap.OrdMap String String
              -> Driver.Checked
              -> OrdMap.OrdMap String String
defHashesInto hs c =
  wholeHash (List.foldl (\m o -> defHashOne m c o) hs c.own) c

assocInt : Fixity.Assoc -> Int
assocInt AssocLeft = 0
assocInt AssocRight = 1
assocInt AssocNone = 2

fixSig : Fixity.Fixities -> String
fixSig f =
  joinWith
    ";"
    (List.map
       (\(g : Fixity.Group) ->
          g.id
          ^ ":"
          ^ debug (assocInt g.assoc)
          ^ Serial.tokBool g.loosest
          ^ ":"
          ^ joinWith " " g.ops)
       f.groups)
  ^ "|"
  ^ joinWith
    ";"
    (List.map (\(e : Fixity.Edge) -> e.tighter ^ ">" ^ e.looser) f.above)

-- | an instance a module declares, as a search in a module importing it
-- | sees it: its key, and its type -- with what the type mentions,
-- | transitively -- for the search to be made again where either changes
instanceSig : OrdMap.OrdMap String String -> Driver.Checked -> String -> String
instanceSig hashes c k = case Globals.lookupEntry c.top.globals k of
  Just e ->
    k
    ^ ":"
    ^ strHash
      (Serial.encodeTy e.tySyntax
       ^ "\n"
       ^ joinWith
         ","
         (List.map
            (\r -> r ^ ":" ^ hashOf hashes r)
            (List.sort (Rename.globalsInTy e.tySyntax))))
  Nothing -> k

-- (what a claim says of a module, as its importers see it)
claimSig : Maybe (List Import.Exposed) -> String
claimSig (Just es) =
  joinWith
    ","
    (List.map
       (\(e : Import.Exposed) -> e.name ^ (if e.tags then "(..)" else ""))
       es)
claimSig Nothing = "*"

-- | what a module's parse takes from a direct import -- the names it
-- | defines and exposes, and the fixities it declares -- and what its
-- | instance searches may find there, the instances it exposes; and what
-- | its claim says, which tags an importer may write
nsHashOf : OrdMap.OrdMap String String -> Driver.Checked -> String
nsHashOf hashes c =
  strHash
    (joinWith "," (List.map (\(o : Driver.Own) -> o.name) c.own)
     ^ "|"
     ^ claimSig c.exposes
     ^ "|"
     ^ fixSig c.fixities
     ^ "|"
     ^ joinWith
       ","
       (List.map (\k -> instanceSig hashes c k) (Driver.exposedInstances c)))

-- | the modules a file imports directly, in scope by name or by alias
directOf : Driver.Source -> List String
directOf s = Driver.importNames (Driver.importsOfSource s).imports

-- Freezing: a clean module as the cache file keeps it
--------------------------------------------------------------------------------

tokPair : Pair String String -> List String
tokPair (MkPair a b) = [Serial.tokStr a, Serial.tokStr b]

tokCount : {a : Type} -> (a -> List String) -> List a -> List String
tokCount f xs = debug (List.length xs) :: List.concatMap f xs

freezeFix : Fixity.Fixities -> List String
freezeFix f =
  List.append
    (tokCount
       (\(g : Fixity.Group) ->
          Serial.tokStr g.id
          :: debug (assocInt g.assoc)
          :: Serial.tokBool g.loosest
          :: Serial.tokStr g.at
          :: tokCount (\o -> [Serial.tokStr o]) g.ops)
       f.groups)
    (tokCount
       (\(e : Fixity.Edge) -> [Serial.tokStr e.tighter, Serial.tokStr e.looser])
       f.above)

nsOf : OrdMap.OrdMap String String -> List Driver.Checked -> String -> String
nsOf hashes done m = case List.find
    (\(d : Driver.Checked) -> strEq d.module m)
    done of
  Just d -> nsHashOf hashes d
  Nothing -> "?"

needsOf : Driver.Checked -> List String
needsOf c =
  List.sort
    (List.keepIf
       (\k ->
          not
            (List.elem k (List.map (\(o : Driver.Own) -> o.key) c.own)))
       (nubCa
          (List.concatMap
             (\(o : Driver.Own) -> case Globals.lookupEntry
                c.top.globals
                o.key of
              Just e ->
                List.append
                  (Rename.globalsInTy e.tySyntax)
                  (Rename.globalsInEl e.syntax)
              Nothing -> Nil)
             c.own)))

freezeDef : OrdMap.OrdMap String String
          -> Driver.Checked
          -> Pair Driver.Own (Pair String Params.Span)
          -> Maybe (List String)
freezeDef hashes c (MkPair o (MkPair _ sp)) = case Globals.lookupEntry
    c.top.globals
    o.key of
  Just e ->
    Just
      [ Serial.tokStr o.name
      , Serial.tokStr o.key
      , Serial.tokBool (Globals.isInstance c.top.globals o.key)
      , Serial.tokStr (hashOf hashes o.key)
      , debug sp.start
      , debug sp.end
      , Serial.encodeTy e.tySyntax
      , Serial.encodeEl e.syntax
      ]
  Nothing -> Nothing

zipCa : {a b : Type} -> List a -> List b -> List (Pair a b)
zipCa (x :: xs) (y :: ys) = MkPair x y :: zipCa xs ys
zipCa _ _ = Nil

consJust : {a : Type} -> a -> Maybe (List a) -> Maybe (List a)
consJust x (Just ys) = Just (x :: ys)
consJust x Nothing = Nothing

allJust : {a : Type} -> List (Maybe a) -> Maybe (List a)
allJust [] = Just Nil
allJust (Nothing :: _) = Nothing
allJust (Just x :: xs) = consJust x (allJust xs)

-- | a clean module as the cache file keeps it: under which version, as
-- | which module (a file system that does not tell case apart has one
-- | file for `a.B` and `a.b`) and from which source it elaborated, what its parse took from each direct import,
-- | which outside definitions it mentions (at which hashes), and its
-- | own definitions' syntax
freeze : OrdMap.OrdMap String String
       -> List Driver.Checked
       -> Driver.Source
       -> Driver.Checked
       -> Maybe String
freeze hashes done s c = case allJust
    (List.map (\p -> freezeDef hashes c p) (zipCa c.own c.top.spans)) of
  Nothing -> Nothing
  Just defs ->
    Just
      (joinWith
         " "
         (List.append
            (Serial.tokStr version
             :: Serial.tokStr s.module
             :: Serial.tokStr (strHash c.source)
             :: freezeFix c.fixities)
            (List.append
               (tokCount
                  (\m -> tokPair (MkPair m (nsOf hashes done m)))
                  (directOf s))
               (List.append
                  (tokCount
                     (\k -> tokPair (MkPair k (hashOf hashes k)))
                     (needsOf c))
                  (tokCount (\d -> d) defs)))))

-- Melting: believing a cache file, or not
--------------------------------------------------------------------------------

mkGroup : String
        -> Fixity.Assoc
        -> Bool
        -> String
        -> List String
        -> Fixity.Group
mkGroup gid assoc loosest at ops =
  { id = gid, assoc = assoc, ops = ops, loosest = loosest, at = at }

mkEdge : String -> String -> Fixity.Edge
mkEdge tighter looser = { tighter = tighter, looser = looser }

mkFixities : List Fixity.Group -> List Fixity.Edge -> Fixity.Fixities
mkFixities groups above = { groups = groups, above = above }

assocOf : Int -> Dec Fixity.Assoc
assocOf 0 = pure AssocLeft
assocOf 1 = pure AssocRight
assocOf 2 = pure AssocNone
assocOf _ = fail

meltFixGroup : Dec Fixity.Group
meltFixGroup = do
  gid <- str
  a <- int
  loosest <- bool
  at <- str
  ops <- many str
  assoc <- assocOf a
  pure (mkGroup gid assoc loosest at ops)

meltFixEdge : Dec Fixity.Edge
meltFixEdge = do
  tighter <- str
  looser <- str
  pure (mkEdge tighter looser)

meltFix : Dec Fixity.Fixities
meltFix = do
  groups <- many meltFixGroup
  above <- many meltFixEdge
  pure (mkFixities groups above)

meltPair : Dec (Pair String String)
meltPair = do
  a <- str
  b <- str
  pure (MkPair a b)

meltDef : Dec (Pair TopLevel.ThawedDef String)
meltDef = do
  name <- str
  key <- str
  isInstance <- bool
  hash <- str
  start <- int
  end <- int
  ty <- Serial.takeTy
  body <- Serial.takeEl
  pure
      (MkPair
         (TopLevel.mkThawedDef
            name
            key
            isInstance
            { start = start, end = end }
            ty
            body)
         (key ^ "\n" ^ hash))

-- (a definition melted, with its key and hash: `key\nhash`)
keyHash : String -> Pair String String
keyHash kh = case split "\n" kh of
  k :: h :: _ -> MkPair k h
  _ -> MkPair kh "?"

mkThawed : Fixity.Fixities
         -> List (Pair TopLevel.ThawedDef String)
         -> Driver.Thawed
mkThawed fixities defs =
  { fixities = fixities
  , defs = List.map fst defs
  , hashes = List.map (\d -> keyHash (snd d)) defs
  }

-- (a direct import, its namespace as it was)
importHolds : OrdMap.OrdMap String String
            -> List Driver.Checked
            -> Pair String String
            -> Bool
importHolds hashes done (MkPair m h) = strEq (nsOf hashes done m) h

-- (a needed definition, at the hash it had)
needHolds : OrdMap.OrdMap String String -> Pair String String -> Bool
needHolds hashes (MkPair k h) = strEq (hashOf hashes k) h

-- | every direct import's namespace as it was, and no other import
importsHold : OrdMap.OrdMap String String
            -> List Driver.Checked
            -> Driver.Source
            -> List (Pair String String)
            -> Bool
importsHold hashes done s ns =
  List.all (importHolds hashes done) ns
  && List.length ns == List.length (directOf s)

needsHold : OrdMap.OrdMap String String -> List (Pair String String) -> Bool
needsHold hashes needs = List.all (needHolds hashes) needs

-- | a module believed back from its cache file: same version, same
-- | module, same source, every direct import's namespace as it was (the
-- | source is the same, so the import list is too), every needed
-- | definition at the hash it had
meltFrom : OrdMap.OrdMap String String
         -> List Driver.Checked
         -> Driver.Source
         -> Dec Driver.Thawed
meltFrom hashes done s = do
  expect version
  expect s.module
  expect (strHash s.source)
  fixities <- meltFix
  ns <- many meltPair
  guard (importsHold hashes done s ns)
  needs <- many meltPair
  guard (needsHold hashes needs)
  defs <- many meltDef
  pure (mkThawed fixities defs)

melt : OrdMap.OrdMap String String
     -> List Driver.Checked
     -> Driver.Source
     -> String
     -> Maybe Driver.Thawed
melt hashes done s text = run (meltFrom hashes done s) text
